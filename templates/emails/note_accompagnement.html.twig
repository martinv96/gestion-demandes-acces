{% apply inline_css %}
<style>
    body {
        margin: 0;
        padding: 0;
        background-color: #c3cee7;
    }
    table {
        border-collapse: collapse;
        mso-table-lspace: 0;
        mso-table-rspace: 0;
    }

    /* Colonne de gauche (Sidebar) */
    .sidebar {
        background-color: #566a7e;
        width: 260px;
        min-width: 260px;
        padding: 40px 20px;
        text-align: center;
        vertical-align: top;
    }
    .sidebar h4 {
        color: #ffffff !important;
        margin: 15px 0 5px;
        font-family: 'Segoe UI', sans-serif;
        font-size: 18px;
    }
    .sidebar p {
        color: #d8e4fd;
        margin: 0;
        font-family: 'Segoe UI', sans-serif;
        font-size: 14px;
        opacity: 0.8;
    }

    /* Contenu mail */
    .main-content {
        background-color: #c3cee7;
        padding: 60px 40px;
        vertical-align: top;
    }
    h2 {
        color: #566a7e;
        font-family: 'Segoe UI', sans-serif;
        font-weight: bold;
        font-size: 28px;
        margin: 0 0 30px;
    }
    .text-intro {
        color: #212529;
        font-family: 'Segoe UI', sans-serif;
        font-size: 16px;
        line-height: 1.6;
        margin-bottom: 30px;
    }

    /* Carte Blanche */
    .info-card {
        background-color: #ffffff;
        border-radius: 8px;
        padding: 30px;
        margin-bottom: 30px;
    }
    .label {
        color: #8898aa;
        font-family: 'Segoe UI', sans-serif;
        font-size: 11px;
        text-transform: uppercase;
        letter-spacing: 1px;
        margin-bottom: 5px;
    }
    .value {
        color: #32325d;
        font-family: 'Segoe UI', sans-serif;
        font-weight: 600;
        font-size: 17px;
        margin-bottom: 20px;
    }
    .badge {
        background-color: #eafaf1;
        border: 1px solid #2ecc71;
        color: #27ae60;
        padding: 6px 15px;
        border-radius: 4px;
        font-weight: bold;
        font-size: 13px;
        display: inline-block;
    }

    /* Listes des Ressources */
    .resource-section-title {
        color: #566a7e;
        font-family: 'Segoe UI', sans-serif;
        font-weight: bold;
        font-size: 15px;
        margin: 25px 0 10px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }
    .resource-list {
        background-color: #f1f4f9;
        border-radius: 8px;
        padding: 15px 20px;
        border: 1px solid #e1e8f0;
        margin-bottom: 20px;
    }
    .resource-item {
        color: #495057;
        font-family: 'Segoe UI', sans-serif;
        font-size: 15px;
        padding: 8px 0;
        border-bottom: 1px solid #dee2e6;
    }
    .resource-item:last-child {
        border-bottom: none;
    }
    .no-resource {
        color: #7f8c8d;
        font-family: 'Segoe UI', sans-serif;
        font-style: italic;
        font-size: 14px;
    }

    /* Bouton */
    .btn-primary {
        background-color: #566a7e;
        color: #ffffff !important;
        padding: 15px 35px;
        text-decoration: none;
        border-radius: 6px;
        font-weight: bold;
        display: inline-block;
        font-family: 'Segoe UI', sans-serif;
        margin-top: 20px;
    }

    /* Footer */
    .footer {
        background-color: #e9ecef;
        padding: 30px;
        text-align: center;
        border-top: 1px solid #dee2e6;
        color: #8898aa;
        font-family: 'Segoe UI', sans-serif;
        font-size: 12px;
    }

    /* mobile */
    @media only screen and (max-width: 600px) {
        .sidebar {
            width: 100px !important;
            min-width: 100px !important;
            padding: 20px 10px !important;
        }
        .sidebar h4 {
            font-size: 12px !important;
            margin: 5px 0 !important;
        }
        .sidebar p {
            font-size: 10px !important;
        }
        .sidebar img {
            width: 60px !important;
        }
        .main-content {
            padding: 25px 15px !important;
        }
        h2 {
            font-size: 20px !important;
            margin-bottom: 15px !important;
        }
        .info-card {
            padding: 15px !important;
        }
        .btn-primary {
            padding: 12px 20px !important;
            margin-top: 20px !important;
        }
    }
</style>

<table width="100%" border="0" cellspacing="0" cellpadding="0">
    <tr>
        {# sidebar #}
        <td class="sidebar">
            <img src="https://www.leplessistrevise.fr/wp-content/themes/leplessistrevise/img/logo.svg" alt="Logo" width="80">
            <h4>Le Plessis-Trévise</h4>
            <p>Gestion des accès</p>
        </td>

        {# contenu principal #}
        <td class="main-content">
            <h2>Note d'accompagnement - Vos accès sont prêts</h2>

            <div class="text-intro">
                Bonjour,<br><br>
                Nous avons le plaisir de vous informer que l'ensemble de vos accès informatiques et de vos matériels sont désormais configurés et prêts pour <strong>votre arrivée</strong>.<br>
                Vous trouverez ci-dessous le récapitulatif des ressources mises à disposition.
            </div>

            <div class="info-card">
                <table width="100%" border="0" cellspacing="0" cellpadding="0">
                    <tr>
                        <td width="50%" valign="top">
                            <div class="label">Référence</div>
                            <div class="value">{{ request.reference|default('#' ~ request.id) }}</div>
                        </td>
                        <td width="50%" valign="top">
                            <div class="label">Agent concerné</div>
                            <div class="value">
                                {% if request.agent %}
                                    {{ request.agent.firstname|capitalize }} {{ request.agent.lastname|upper }}
                                {% else %}
                                    Agent non spécifié
                                {% endif %}
                            </div>
                        </td>
                    </tr>
                    <tr>
                        <td width="50%" valign="top">
                            <div class="label">Service affectation</div>
                            <div class="value">
                                {% if request.agent and request.agent.service %}
                                    {{ request.agent.service.name }}
                                {% else %}
                                    Non spécifié
                                {% endif %}
                            </div>
                        </td>
                        <td width="50%" valign="top">
                            <div class="label">Date d'arrivée</div>
                            <div class="value">
                                {% if request.arrivalDate %}
                                    {{ request.arrivalDate|date('d/m/Y') }}
                                {% else %}
                                    Non spécifiée
                                {% endif %}
                            </div>
                        </td>
                    </tr>
                    <tr>
                        <td colspan="2" style="padding-top: 10px;">
                            <div class="label">Statut de la demande</div>
                            <div class="badge">TRAITÉE &amp; CONFIGURÉE</div>
                        </td>
                    </tr>
                </table>
            </div>

            {# section logiciel #}
            <div class="resource-section-title">Logiciels &amp; Comptes d'accès activés :</div>
            <div class="resource-list">
                {% set hasLogiciel = false %}
                {% for ressource in request.ressources %}
                    {% if ressource.category == 'logiciel' %}
                        <div class="resource-item">✓ {{ ressource.name }}</div>
                        {% set hasLogiciel = true %}
                    {% endif %}
                {% else %}
                    <div class="no-resource">Aucun compte logiciel spécifique demandé.</div>
                {% endfor %}
                {% if not hasLogiciel and request.ressources|length > 0 %}
                    <div class="no-resource">Aucun compte logiciel spécifique demandé.</div>
                {% endif %}
            </div>

            {# section matériels #}
            <div class="resource-section-title">Matériels préparés :</div>
            <div class="resource-list">
                {% set hasMateriel = false %}
                {% for ressource in request.ressources %}
                    {% if ressource.category == 'materiel' %}
                        <div class="resource-item">📦 {{ ressource.name }}</div>
                        {% set hasMateriel = true %}
                    {% endif %}
                {% else %}
                    <div class="no-resource">Aucun matériel spécifique demandé.</div>
                {% endfor %}
                {% if not hasMateriel and request.ressources|length > 0 %}
                    <div class="no-resource">Aucun matériel spécifique demandé.</div>
                {% endif %}
            </div>

            <div class="text-intro" style="margin-top: 30px;">
                Les identifiants temporaires et les modalités de remise des équipements (badges, clés, ordinateurs ou téléphones) vous seront communiqués lors de la prise de poste ou sont à retirer auprès des services concernés (DSI / Services Techniques).
            </div>
        </td>
    </tr>
    {# FOOTER #}
    <tr>
        <td colspan="2" class="footer">
            <p style="margin-bottom: 5px;">Ceci est une note d'accompagnement automatique envoyée par GDAP (la plateforme de Gestion des Accès).</p>
            <strong>Mairie du Plessis-Trévise</strong>
            &copy; {{ "now"|date("Y") }}
        </td>
    </tr>
</table>
{% endapply %}
