{% apply inline_css %}
<style>
    body { margin: 0; padding: 0; background-color: #f6f6f6; }
    .sidebar { background-color: #a35233; width: 260px; min-width: 260px; padding: 40px 20px; text-align: center; vertical-align: top; }
    .sidebar h4 { color: #fff !important; margin: 15px 0 5px; font-family: 'Segoe UI', sans-serif; font-size: 18px; }
    .sidebar p { color: #f2d7cc; margin: 0; font-family: 'Segoe UI', sans-serif; font-size: 13px; opacity: 0.8; }
    .main-content { background-color: #fff; padding: 60px 40px; vertical-align: top; }
    h2 { color: #a35233; font-family: 'Segoe UI', sans-serif; font-weight: bold; font-size: 24px; margin: 0 0 25px; }
    .info-card { background-color: #f2f2f2; border-radius: 8px; padding: 30px; margin-bottom: 30px; }
    .label { color: #6e7985; font-size: 11px; text-transform: uppercase; margin-bottom: 5px; }
    .value { color: #2c3e50; font-weight: 600; font-size: 17px; margin-bottom: 20px; }
    .badge { background-color: #f8f1ed; border: 1px solid #e6ccbe; color: #a35233; padding: 6px 15px; border-radius: 4px; font-weight: bold; font-size: 12px; display: inline-block; }
    .reminder-message { color: #a35233; font-size: 16px; margin: 20px 0; }
    .footer { background-color: #e9ecef; padding: 30px; text-align: center; color: #7f8c8d; font-size: 11px; }
</style>

<table width="100%" border="0" cellspacing="0" cellpadding="0">
    <tr>
        <td class="sidebar">
            <img src="https://www.leplessistrevise.fr/wp-content/themes/leplessistrevise/img/logo.svg" alt="logo" width="75">
            <h4>Le Plessis-Trévise</h4>
            <p>Gestion des accès</p>
        </td>
        <td class="main-content">
            <h2>Rappel - Demande en attente</h2>
            <div class="reminder-message">
                {{ reminder_message|default('Ceci est un rappel automatique concernant une demande en attente de validation.') }}
            </div>
            <div class="info-card">
                <div class="label">Référence</div>
                <div class="value">{{ request.reference|default('#' ~ request.id) }}</div>
                <div class="label">Agent</div>
                <div class="value">{{ request.agent.firstname|capitalize }} {{ request.agent.lastname|upper }}</div>
                <div class="label">Statut actuel</div>
                <div class="value">{{ status_label }}</div>
            </div>
            <div style="text-align: center">
                <a href="{{ url('app_request_show', {id:request.id}) }}" class="btn-primary">Voir la demande</a>
            </div>
        </td>
    </tr>
    <tr>
        <td colspan="2" class="footer">
            <p>Ceci est un rappel automatique envoyé par GDAP (la plateforme de gestion des accès).<br>
            <strong>Mairie du Plessis-Trévise</strong> &copy; {{"nov"|date("Y") }}</p>
        </td>
    </tr>
</table>
{% endapply %}