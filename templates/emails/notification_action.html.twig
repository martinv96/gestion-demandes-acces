{% apply inky_to_html|inline_css %}
<style>
    .header { background: #e67e22; padding: 20px; text-align: center; color: white; }
    .content { padding: 30px; font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; color: #333; }
    .btn { background: #e67e22; color: white; padding: 15px 25px; text-decoration: none; border-radius: 4px; font-weight: bold; display: inline-block; }
    .card { background: #fdf2e9; border: 1px solid #fab1a0; padding: 20px; border-radius: 8px; margin: 20px 0; }
</style>
<container>
    <row class="header">
        <columns><h1>Action Attendue</h1></columns>
    </row>
    <row>
        <columns class="content">
            <p>Bonjour,</p>
            <p>Une demande nécessite votre intervention pour passer à l'étape suivante du workflow.</p>
            
            <div class="card">
                <strong>Demande #{{ request.id }}</strong><br>
                <strong>Agent :</strong> {{ request.agent.firstname }} {{ request.agent.lastname }}<br>
                <strong>Étape actuelle :</strong> {{ status_label }}
            </div>

            <p><strong>Dernière note :</strong><br>
            <span style="color: #666; font-style: italic;">"{{ last_comment }}"</span></p>

            <spacer size="20"></spacer>
            <center>
                <button href="{{ url('app_request_show', {id: request.id}) }}" class="btn">Accéder à la demande</button>
            </center>
        </columns>
    </row>
</container>
{% endapply %}