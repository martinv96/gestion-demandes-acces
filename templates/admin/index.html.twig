{% extends 'base.html.twig' %}

{% block title %}Administrateur
{% endblock %}

{% block body %}
	<div class="container-fluid">

		{% set adminSubtitleMap = {
        'users': 'Gestion des comptes',
        'services': 'Gestion des services',
        'logiciels': 'Gestion des logiciels'
    } %}

		{# En-tête #}
		<div class="mb-4">
			<h1 class="h3 mb-1">Administrateur</h1>
			<p class="text-muted mb-0" id="adminSubtitle">{{ adminSubtitleMap[tab] ?? 'Gestion des comptes' }}</p>
		</div>

		{# Onglets - navigation entre les différentes sections #}
		<ul class="nav admin-tabs mb-4" id="adminTabs" role="tablist">
			<li class="nav-item" role="presentation">
				<button class="admin-tab-btn {{ tab == 'users' ? 'active' : '' }}" data-bs-toggle="tab" data-bs-target="#tab-users" type="button" role="tab">
					Comptes
				</button>
			</li>
			<li class="nav-item" role="presentation">
				<button class="admin-tab-btn {{ tab == 'services' ? 'active' : '' }}" data-bs-toggle="tab" data-bs-target="#tab-services" type="button" role="tab">
					Services
				</button>
			</li>
			<li class="nav-item" role="presentation">
				<button class="admin-tab-btn {{ tab == 'logiciels' ? 'active' : '' }}" data-bs-toggle="tab" data-bs-target="#tab-logiciels" type="button" role="tab">
					Logiciels
				</button>
			</li>
		</ul>

		<div
			class="tab-content">

			{# compteS - fenetre comptes (voir, modifier, supprimer) #}
			<div class="tab-pane fade {{ tab == 'users' ? 'show active' : '' }}" id="tab-users" role="tabpanel">

				<div class="d-flex justify-content-end mb-3">
					<button class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#addUserModal">
						+ Ajouter un compte
					</button>
				</div>

				<div class="card border-0 shadow-sm">
					<div class="card-body p-0">
						<table class="table table-hover admin-table mb-0">
							<thead>
								<tr>
									<th>Compte</th>
									<th>Email</th>
									<th>Rôle</th>
									<th>Service</th>
									<th>Statut</th>
									<th class="text-end" style="padding-right: 2.2rem">Action</th>
								</tr>
							</thead>
							<tbody>
								{% for user in users %}
									<tr>
										<td>{{ user.displayName }}</td>
										<td class="text-muted">{{ user.email }}</td>
										<td>
											{% set statusMap = {
                                        'ROLE_ADMIN': 'Administrateur',
                                        'ROLE_USER': 'Compte'
                                    } %}
											{{ statusMap[user.role ? user.role.label : ''] ?? '-' }}
										</td>

										<td>{{ user.service ? user.service.name : '-' }}</td>
										<td>
											{# Badge cliquable pour basculer le statut #}
											<form method="post" action="{{ path('app_admin_user_toggle', {id: user.id}) }}" class="d-inline">
												<input type="hidden" name="_token" value="{{ csrf_token('admin_user_toggle_' ~ user.id) }}">
												<button type="submit" class="badge border-0 text-bg-{{ user.isActive ? 'success' : 'secondary' }} admin-badge-btn" title="{{ user.isActive ? 'Cliquer pour désactiver' : 'Cliquer pour activer' }}">
													{{ user.isActive ? 'actif' : 'inactif' }}
												</button>
											</form>
										</td>
										<td class="text-end">
											<form method="post" action="{{ path('app_admin_user_reset_password', {id: user.id}) }}" class="d-inline" id="resetPasswordForm{{ user.id }}">
												<input type="hidden" name="_token" value="{{ csrf_token('admin_user_reset_password_' ~ user.id) }}">
												<button type="button" class="btn btn-icon text-warning js-delete-trigger" title="Réinitialiser le mot de passe" data-form-id="resetPasswordForm{{ user.id }}" data-delete-title="Réinitialiser le mot de passe ?" data-delete-message="Un nouveau mot de passe provisoire sera généré pour <strong>{{ user.displayName|e('html') }}</strong>." data-delete-confirm-label="Réinitialiser" data-delete-btn-class="btn btn-warning">
													<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewbox="0 0 16 16">
														<path d="M8 3a5 5 0 1 0 4.546 2.914.5.5 0 0 1 .908-.417A6 6 0 1 1 8 2z"/>
														<path d="M8 4.466V.534a.25.25 0 0 1 .41-.192l2.36 1.966c.12.1.12.284 0 .384L8.41 4.658A.25.25 0 0 1 8 4.466"/>
													</svg>
												</button>
											</form>
											<button type="button" class="btn btn-icon" title="Modifier" data-bs-toggle="modal" data-bs-target="#editUserModal{{ user.id }}">
												<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewbox="0 0 16 16">
													<path d="M12.146.146a.5.5 0 0 1 .708 0l3 3a.5.5 0 0 1 0 .708l-10 10a.5.5 0 0 1-.168.11l-5 2a.5.5 0 0 1-.65-.65l2-5a.5.5 0 0 1 .11-.168l10-10zM11.207 2.5 13.5 4.793 14.793 3.5 12.5 1.207zm1.586 3L10.5 3.207 4 9.707V10h.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.5h.293zm-9.761 5.175-.106.106-1.528 3.821 3.821-1.528.106-.106A.5.5 0 0 1 5 12.5V12h-.5a.5.5 0 0 1-.5-.5V11h-.5a.5.5 0 0 1-.468-.325z"/>
												</svg>
											</button>
											<form method="post" action="{{ path('app_admin_user_delete', {id: user.id}) }}" class="d-inline" id="deleteUserForm{{ user.id }}">
												<input type="hidden" name="_token" value="{{ csrf_token('admin_user_delete_' ~ user.id) }}">
												<button type="button" class="btn btn-icon text-danger js-delete-trigger" title="Supprimer" data-form-id="deleteUserForm{{ user.id }}" data-delete-title="Supprimer ce compte ?" data-delete-message="Le compte <strong>{{ user.displayName|trim|e('html') }}</strong> sera supprimé définitivement." data-delete-confirm-label="Supprimer le compte">
													<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewbox="0 0 16 16">
														<path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0z"/>
														<path d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1zM4.118 4 4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4zM2.5 3h11V2h-11z"/>
													</svg>
												</button>
											</form>
										</td>
									</tr>
								{% else %}
									<tr>
										<td colspan="6" class="text-center text-muted py-5">Aucun compte enregistré.</td>
									</tr>
								{% endfor %}
							</tbody>
						</table>
					</div>
				</div>
			</div>

			{# SERVICES - fenetre services (voir, modifier, supprimer#}
			<div class="tab-pane fade {{ tab == 'services' ? 'show active' : '' }}" id="tab-services" role="tabpanel">

				<div class="d-flex justify-content-end mb-3">
					<button class="btn btn-outline-secondary btn-sm" data-bs-toggle="modal" data-bs-target="#addServiceModal">
						Ajouter un Service
					</button>
				</div>

				<div class="card border-0 shadow-sm">
					<div class="card-body p-0">
						<table class="table table-hover admin-table mb-0">
							<thead>
								<tr>
									<th>Services</th>
									<th>Code workflow</th>
									<th class="text-end" style="padding-right: 1.4rem">Action</th>
								</tr>
							</thead>
							<tbody>
								{% for service in services %}
									<tr>
										<td>{{ service.name }}</td>
										<td>
											{% if service.code %}
												<span class="badge text-bg-secondary">{{ service.code }}</span>
											{% else %}
												<span class="text-muted">-</span>
											{% endif %}
										</td>
										<td class="text-end">
											<button type="button" class="btn btn-icon js-open-modal" title="Modifier" data-bs-toggle="modal" data-bs-target="#editServiceModal{{ service.id }}" data-open-modal-id="editServiceModal{{ service.id }}">
												<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewbox="0 0 16 16">
													<path d="M12.146.146a.5.5 0 0 1 .708 0l3 3a.5.5 0 0 1 0 .708l-10 10a.5.5 0 0 1-.168.11l-5 2a.5.5 0 0 1-.65-.65l2-5a.5.5 0 0 1 .11-.168l10-10zM11.207 2.5 13.5 4.793 14.793 3.5 12.5 1.207zm1.586 3L10.5 3.207 4 9.707V10h.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.5h.293zm-9.761 5.175-.106.106-1.528 3.821 3.821-1.528.106-.106A.5.5 0 0 1 5 12.5V12h-.5a.5.5 0 0 1-.5-.5V11h-.5a.5.5 0 0 1-.468-.325z"/>
												</svg>
											</button>
											<form method="post" action="{{ path('app_admin_service_delete', {id: service.id}) }}" class="d-inline" id="deleteServiceForm{{ service.id }}">
												<input type="hidden" name="_token" value="{{ csrf_token('admin_service_delete_' ~ service.id) }}">
												<button type="button" class="btn btn-icon text-danger js-delete-trigger" title="Supprimer" data-form-id="deleteServiceForm{{ service.id }}" data-delete-title="Supprimer ce service ?" data-delete-message="Le service <strong>{{ service.name|e('html') }}</strong> sera supprimé définitivement." data-delete-confirm-label="Supprimer le service">
													<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewbox="0 0 16 16">
														<path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0z"/>
														<path d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1zM4.118 4 4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4zM2.5 3h11V2h-11z"/>
													</svg>
												</button>
											</form>
										</td>
									</tr>
								{% else %}
									<tr>
										<td colspan="2" class="text-center text-muted py-5">Aucun service enregistré.</td>
									</tr>
								{% endfor %}
							</tbody>
						</table>
					</div>
				</div>
			</div>

			{# LOGICIELS - fenetre logiciels (voir, modifier, supprimer) #}
			<div class="tab-pane fade {{ tab == 'logiciels' ? 'show active' : '' }}" id="tab-logiciels" role="tabpanel">

				<div class="d-flex justify-content-end mb-3">
					<button class="btn btn-outline-secondary btn-sm" data-bs-toggle="modal" data-bs-target="#addLogicielModal">
						Ajouter un logiciel
					</button>
				</div>

				<div class="card border-0 shadow-sm">
					<div class="card-body p-0">
						<table class="table table-hover admin-table mb-0">
							<thead>
								<tr>
									<th>Logiciels</th>
									<th>Statut</th>
									<th class="text-end" style="padding-right: 1.4rem">Action</th>
								</tr>
							</thead>
							<tbody>
								{% for logiciel in logiciels %}
									<tr>
										<td>{{ logiciel.name }}</td>
										<td>
											<form method="post" action="{{ path('app_admin_logiciel_toggle', {id: logiciel.id}) }}" class="d-inline">
												<input type="hidden" name="_token" value="{{ csrf_token('admin_logiciel_toggle_' ~ logiciel.id) }}">
												<button type="submit" class="badge border-0 text-bg-{{ logiciel.isActive ? 'success' : 'secondary' }} admin-badge-btn" title="{{ logiciel.isActive ? 'Cliquer pour désactiver' : 'Cliquer pour activer' }}">
													{{ logiciel.isActive ? 'Actif' : 'Inactif' }}
												</button>
											</form>
										</td>
										<td class="text-end">
											<button type="button" class="btn btn-icon" title="Modifier" data-bs-toggle="modal" data-bs-target="#editLogicielModal{{ logiciel.id }}">
												<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewbox="0 0 16 16">
													<path d="M12.146.146a.5.5 0 0 1 .708 0l3 3a.5.5 0 0 1 0 .708l-10 10a.5.5 0 0 1-.168.11l-5 2a.5.5 0 0 1-.65-.65l2-5a.5.5 0 0 1 .11-.168l10-10zM11.207 2.5 13.5 4.793 14.793 3.5 12.5 1.207zm1.586 3L10.5 3.207 4 9.707V10h.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.5h.293zm-9.761 5.175-.106.106-1.528 3.821 3.821-1.528.106-.106A.5.5 0 0 1 5 12.5V12h-.5a.5.5 0 0 1-.5-.5V11h-.5a.5.5 0 0 1-.468-.325z"/>
												</svg>
											</button>
											<form method="post" action="{{ path('app_admin_logiciel_delete', {id: logiciel.id}) }}" class="d-inline" id="deleteLogicielForm{{ logiciel.id }}">
												<input type="hidden" name="_token" value="{{ csrf_token('admin_logiciel_delete_' ~ logiciel.id) }}">
												<button type="button" class="btn btn-icon text-danger js-delete-trigger" title="Supprimer" data-form-id="deleteLogicielForm{{ logiciel.id }}" data-delete-title="Supprimer ce logiciel ?" data-delete-message="Le logiciel <strong>{{ logiciel.name|e('html') }}</strong> sera supprimé définitivement." data-delete-confirm-label="Supprimer le logiciel">
													<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewbox="0 0 16 16">
														<path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0z"/>
														<path d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1zM4.118 4 4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4zM2.5 3h11V2h-11z"/>
													</svg>
												</button>
											</form>
										</td>
									</tr>
								{% else %}
									<tr>
										<td colspan="3" class="text-center text-muted py-5">Aucun logiciel enregistré.</td>
									</tr>
								{% endfor %}
							</tbody>
						</table>
					</div>
				</div>
			</div>

		</div>
		{# /tab-content #}
	</div>


	{#  TOUTES LES MODALS #}

	{# ── Ajouter un compte ── #}
	<div class="modal fade" id="addUserModal" tabindex="-1" aria-labelledby="addUserModalLabel" aria-hidden="true">
		<div class="modal-dialog modal-dialog-centered">
			<div class="modal-content admin-modal">
				<div class="modal-header border-0 pb-1">
					<div>
						<h5 class="modal-title mb-0" id="addUserModalLabel">Ajouter un compte</h5>
						<p class="text-primary small mb-0">Créer un nouveau compte pour accéder à l'application</p>
					</div>
					<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
				</div>
				<form method="post" action="{{ path('app_admin_user_add') }}">
					<input type="hidden" name="_token" value="{{ csrf_token('admin_user_add') }}">
					<div class="modal-body">
						<div class="mb-3">
							<label class="form-label">Email</label>
							<input type="email" class="form-control" name="email" placeholder="email@mairie.fr" required autocomplete="off">
						</div>
						<div class="mb-3">
							<label class="form-label">Rôle</label>
							<select class="form-select" name="role_id">
								<option value="">Sélectionner un rôle</option>
								{% set statusMap = {
                                'ROLE_ADMIN': 'Administrateur',
                                'ROLE_USER': 'Compte'
                            } %}
								{% for role in roles %}
									<option value="{{ role.id }}">{{ statusMap[role.label] ?? '-' }}</option>
								{% endfor %}
							</select>
						</div>
						<div class="mb-3">
							<label class="form-label">Service</label>
							<select class="form-select" name="service_id">
								<option value="">Sélectionner un service</option>
								{% for service in services %}
									<option value="{{ service.id }}">{{ service.name }}</option>
								{% endfor %}
							</select>
						</div>
						<p class="text-muted small mb-0">
							Un mot de passe provisoire sera généré automatiquement et affiché après la création.
						</p>
					</div>
					<div class="modal-footer border-0 pt-0">
						<button type="submit" class="btn btn-primary">Créer</button>
						<button type="button" class="btn btn-link text-secondary" data-bs-dismiss="modal">Annuler</button>
					</div>
				</form>
			</div>
		</div>
	</div>

	{# ── Modifier chaque compte ── #}
	{% for user in users %}
		<div class="modal fade" id="editUserModal{{ user.id }}" tabindex="-1" aria-hidden="true">
			<div class="modal-dialog modal-dialog-centered">
				<div class="modal-content admin-modal">
					<div class="modal-header border-0 pb-1">
						<h5 class="modal-title">Modifier le compte</h5>
						<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
					</div>
					<form method="post" action="{{ path('app_admin_user_edit', {id: user.id}) }}">
						<input type="hidden" name="_token" value="{{ csrf_token('admin_user_edit_' ~ user.id) }}">
						<div class="modal-body">
							<div class="row g-3">
								<div class="col-md-6">
									<label class="form-label">Compte</label>
									<input type="text" class="form-control" name="lastname" value="{{ user.displayName }}" required>
								</div>
							</div>
							<div class="mb-3">
								<label class="form-label">Email</label>
								<input type="email" class="form-control" name="email" value="{{ user.email }}" required>
							</div>
							<div class="mb-3">
								<label class="form-label">Rôle</label>
								<select class="form-select" name="role_id">
									<option value="">Aucun rôle</option>
									{% for role in roles %}
										{% set statusMap = {
                                        'ROLE_ADMIN': 'Administrateur',
                                        'ROLE_USER': 'Compte'
                                    } %}
										<option value="{{ role.id }}" {{ user.role and user.role.id == role.id ? 'selected' : '' }}>
											{{ statusMap[role.label] ?? '-' }}
										</option>
									{% endfor %}
								</select>
							</div>
							<div class="mb-3">
								<label class="form-label">Service</label>
								<select class="form-select" name="service_id">
									<option value="">Aucun service</option>
									{% for service in services %}
										<option value="{{ service.id }}" {{ user.service and user.service.id == service.id ? 'selected' : '' }}>
											{{ service.name }}
										</option>
									{% endfor %}
								</select>
							</div>
						</div>
						<div class="modal-footer border-0 pt-0">
							<button type="submit" class="btn btn-primary">Enregistrer</button>
							<button type="button" class="btn btn-link text-secondary" data-bs-dismiss="modal">Annuler</button>
						</div>
					</form>
				</div>
			</div>
		</div>
	{% endfor %}

	{# ── Ajouter un service ── #}
	<div class="modal fade" id="addServiceModal" tabindex="-1" aria-hidden="true">
		<div class="modal-dialog modal-dialog-centered">
			<div class="modal-content admin-modal">
				<div class="modal-header border-0 pb-1">
					<h5 class="modal-title">Ajouter un Service</h5>
					<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
				</div>
				<form method="post" action="{{ path('app_admin_service_add') }}">
					<input type="hidden" name="_token" value="{{ csrf_token('admin_service_add') }}">
					<div class="modal-body">
						<div class="mb-3">
							<label class="form-label">Nom du service</label>
							<input type="text" class="form-control" name="name" placeholder="Ex : Direction Générale des Services" required autocomplete="off">
						</div>
						<div class="mb-3">
							<label class="form-label">Email du service
								<span class="text-muted">(optionnel)</span>
							</label>
							<input type="email" class="form-control" name="email" placeholder="service@mairie.fr">
						</div>
						<div class="mb-3">
							<label class="form-label">Code workflow
								<span class="text-muted">(optionnel)</span>
							</label>
							<input type="text" class="form-control" name="code" placeholder="Ex : RH, ST, DSI" maxlength="20" autocomplete="off">
							<div class="form-text">Code acteur de validation. Exemple: EDU ajoute une étape ROLE_EDU.</div>
						</div>
						<div class="modal-footer border-0 pt-0">
							<button type="submit" class="btn btn-primary">Créer</button>
							<button type="button" class="btn btn-link text-secondary" data-bs-dismiss="modal">Annuler</button>
						</div>
					</form>
				</div>
			</div>
		</div>
	</div>

		{# ── Modifier chaque service ── #}
		{% for service in services %}
			<div class="modal fade" id="editServiceModal{{ service.id }}" tabindex="-1" aria-hidden="true">
				<div class="modal-dialog modal-dialog-centered">
					<div class="modal-content admin-modal">
						<div class="modal-header border-0 pb-1">
							<h5 class="modal-title">Modifier le service</h5>
							<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
						</div>
						<form method="post" action="{{ path('app_admin_service_edit', {id: service.id}) }}">
							<input type="hidden" name="_token" value="{{ csrf_token('admin_service_edit_' ~ service.id) }}">
							<div class="modal-body">
								<div class="mb-3">
									<label class="form-label">Nom du service</label>
									<input type="text" class="form-control" name="name" value="{{ service.name }}" required>
								</div>
								<div class="mb-3">
									<label class="form-label">Email du service</label>
									<input type="email" class="form-control" name="email" value="{{ service.email }}">
								</div>
								<div class="mb-3">
									<label class="form-label">Code workflow</label>
									<input type="text" class="form-control" name="code" value="{{ service.code }}" placeholder="Ex : RH, ST, DSI, EDU" maxlength="20" autocomplete="off">
								</div>
							</div>
							<div class="modal-footer border-0 pt-0">
								<button type="submit" class="btn btn-primary">Enregistrer</button>
								<button type="button" class="btn btn-link text-secondary" data-bs-dismiss="modal">Annuler</button>
							</div>
						</form>
					</div>
				</div>
			</div>
		{% endfor %}

		{# ── Ajouter un logiciel ── #}
		<div class="modal fade" id="addLogicielModal" tabindex="-1" aria-hidden="true">
			<div class="modal-dialog modal-dialog-centered">
				<div class="modal-content admin-modal">
					<div class="modal-header border-0 pb-1">
						<h5 class="modal-title">Ajouter un logiciel</h5>
						<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
					</div>
					<form method="post" action="{{ path('app_admin_logiciel_add') }}">
						<input type="hidden" name="_token" value="{{ csrf_token('admin_logiciel_add') }}">
						<div class="modal-body">
							<div class="mb-3">
								<label class="form-label">Nom du logiciel</label>
								<input type="text" class="form-control" name="name" placeholder="Ex : Ciril RH" required autocomplete="off">
							</div>
						</div>
						<div class="modal-footer border-0 pt-0">
							<button type="submit" class="btn btn-primary">Ajouter</button>
							<button type="button" class="btn btn-link text-secondary" data-bs-dismiss="modal">Annuler</button>
						</div>
					</form>
				</div>
			</div>
		</div>

		{# ── Modifier chaque logiciel ── #}
		{% for logiciel in logiciels %}
			<div class="modal fade" id="editLogicielModal{{ logiciel.id }}" tabindex="-1" aria-hidden="true">
				<div class="modal-dialog modal-dialog-centered">
					<div class="modal-content admin-modal">
						<div class="modal-header border-0 pb-1">
							<h5 class="modal-title">Modifier le logiciel</h5>
							<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
						</div>
						<form method="post" action="{{ path('app_admin_logiciel_edit', {id: logiciel.id}) }}">
							<input type="hidden" name="_token" value="{{ csrf_token('admin_logiciel_edit_' ~ logiciel.id) }}">
							<div class="modal-body">
								<div class="mb-3">
									<label class="form-label">Nom du logiciel</label>
									<input type="text" class="form-control" name="name" value="{{ logiciel.name }}" required>
								</div>
							</div>
							<div class="modal-footer border-0 pt-0">
								<button type="submit" class="btn btn-primary">Enregistrer</button>
								<button type="button" class="btn btn-link text-secondary" data-bs-dismiss="modal">Annuler</button>
							</div>
						</form>
					</div>
				</div>
			</div>
		{% endfor %}

		{# MODAL DE CONFIRMATION DE SUPPRESSION #}

		<div class="modal fade" id="deleteConfirmModal" tabindex="-1" aria-hidden="true" aria-labelledby="deleteConfirmModalLabel">
			<div class="modal-dialog modal-dialog-centered">
				<div class="modal-content admin-modal">
					<div class="modal-header border-0 pb-1">
						<h5 class="modal-title" id="deleteConfirmModalLabel">Confirmer la suppression</h5>
						<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
					</div>
					<div class="modal-body">
						<p class="mb-0" id="deleteConfirmModalMessage">Cette action est irréversible.</p>
					</div>
					<div class="modal-footer border-0 pt-0">
						<button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Annuler</button>
						<button type="button" class="btn btn-danger" id="deleteConfirmSubmitBtn">Supprimer</button>
					</div>
				</div>
			</div>
		</div>

		{# SCRIPTS #}

		<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
		<script>
			document.addEventListener('DOMContentLoaded', function () {
const adminTabs = document.getElementById('adminTabs');
const adminSubtitle = document.getElementById('adminSubtitle');

const subtitles = {
'#tab-users': 'Gestion des comptes',
'#tab-services': 'Gestion des services',
'#tab-logiciels': 'Gestion des logiciels'
};

if (adminTabs && adminSubtitle) {
adminTabs.addEventListener('shown.bs.tab', function (event) {
const target = event.target.getAttribute('data-bs-target');

if (subtitles[target]) {
adminSubtitle.textContent = subtitles[target];
}
});
}

const confirmModalElement = document.getElementById('deleteConfirmModal');
const confirmModalTitle = document.getElementById('deleteConfirmModalLabel');
const confirmModalMessage = document.getElementById('deleteConfirmModalMessage');
const confirmSubmitButton = document.getElementById('deleteConfirmSubmitBtn');
const deleteTriggers = document.querySelectorAll('.js-delete-trigger');

if (! confirmModalElement || ! confirmSubmitButton || deleteTriggers.length === 0) {
return;
}

const confirmModal = new bootstrap.Modal(confirmModalElement);
let formToSubmit = null;

deleteTriggers.forEach(function (trigger) {
trigger.addEventListener('click', function () {
const formId = trigger.dataset.formId;
formToSubmit = formId ? document.getElementById(formId) : null;

if (! formToSubmit) {
return;
}

const title = trigger.dataset.deleteTitle || 'Confirmer la suppression';
const message = trigger.dataset.deleteMessage || 'Cette action est irréversible.';
const confirmLabel = trigger.dataset.deleteConfirmLabel || 'Supprimer';
const btnClass = trigger.dataset.deleteBtnClass || 'btn btn-danger';

confirmModalTitle.textContent = title;
confirmModalMessage.innerHTML = message;
confirmSubmitButton.textContent = confirmLabel;
confirmSubmitButton.className = btnClass;

confirmModal.show();
});
});

confirmSubmitButton.addEventListener('click', function () {
if (formToSubmit) {
formToSubmit.submit();
}
});

		const modalTriggers = document.querySelectorAll('.js-open-modal');
		modalTriggers.forEach(function (trigger) {
			trigger.addEventListener('click', function () {
				const modalId = trigger.dataset.openModalId;
				if (!modalId) {
					return;
				}

				const modalElement = document.getElementById(modalId);
				if (!modalElement) {
					return;
				}

				const modal = bootstrap.Modal.getOrCreateInstance(modalElement);
				modal.show();
			});
		});
});
		</script>
	{% endblock %}
