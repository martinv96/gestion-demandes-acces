<div class="tab-pane fade {{ tab == 'audits' ? 'show active' : '' }}" id="tab-audits" role="tabpanel">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <div class="small text-muted">
            Historique des connexions
        </div>
    </div>

    <div class="row g-3 mb-3">
        <div class="col-md-3">
            <div class="card border-0 shadow-sm"><div class="card-body">
                <div class="text-muted small">Connexions réussies</div>
                <div class="h5 mb-0">{{ liveSuccess }}</div>
            </div></div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm"><div class="card-body">
                <div class="text-muted small">Connexions échouées</div>
                <div class="h5 mb-0">{{ liveFailure }}</div>
            </div></div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm"><div class="card-body">
                <div class="text-muted small">Déconnexions</div>
                <div class="h5 mb-0">{{ liveLogout }}</div>
            </div></div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm"><div class="card-body">
                <div class="text-muted small">Historique purgé conservé</div>
                <div class="h5 mb-0">{{ historyTotals.purged }}</div>
            </div></div>
        </div>
    </div>

        <div class="card mb-4 p-3">
            <form method="GET">
                <input type="hidden" name="tab" value="audits">

                    <div class="d-flex align-items-center gap-2 mb-1">
                        <img src="{{ asset('images/filtres/filtre.png') }}" alt="Filtres" style="width:16px;height:16px;object-fit:contain;">
                        <label class="form-label form-label-sm mb-1 text-muted fw-semibold d-inline-block">Filtres</label>
                    </div>

                <div class="row g-3 align-items-end">
                    <div class="col-12 col-md-6 col-xl-4">
                        <label class="form-label form-label-sm mb-1 text-muted fw-semibold">Type d’événement</label>
                        <select name="audit_event_type" class="form-select form-select-sm" onchange="this.form.submit()">
                            <option value="">Tous les événements</option>
                            <option value="success" {{ auditFilters.eventType == 'success' ? 'selected' : '' }}>Connexion réussie</option>
                            <option value="failure" {{ auditFilters.eventType == 'failure' ? 'selected' : '' }}>Échec de connexion</option>
                            <option value="logout" {{ auditFilters.eventType == 'logout' ? 'selected' : '' }}>Déconnexion</option>
                        </select>
                    </div>

                    {% if auditFilters.eventType %}
                        <div class="col-12 col-md-6 col-xl-2 d-grid">
                            <a href="{{ path('app_admin_index', { tab: 'audits' }) }}" class="btn btn-sm btn-outline-secondary">Réinitialiser</a>
                        </div>
                    {% endif %}
                </div>
            </form>
        </div>

    <div class="card border-0 shadow-sm mb-3">
        <div class="card-header bg-transparent">
            <strong>Connexions récentes</strong>
        </div>
        <div class="card-body p-0">
            <table class="table table-hover admin-table mb-0">
                <thead>
                <tr>
                    <th>Date</th>
                    <th>Type</th>
                    <th>Email</th>
                    <th>IP</th>
                    <th>Détail</th>
                </tr>
                </thead>
                <tbody>
                {% for audit in audits %}
                    <tr>
                        <td>{{ audit.occurredAt|date('d/m/Y H:i:s') }}</td>
                        <td>
                            {% set typeLabels = {'success': 'Connexion réussie', 'failure': 'Échec de connexion', 'logout': 'Déconnexion'} %}
                            {% set color = audit.eventType == 'success' ? 'success' : (audit.eventType == 'failure' ? 'danger' : 'secondary') %}
                            <span class="badge text-bg-{{ color }}">{{ typeLabels[audit.eventType] ?? audit.eventType }}</span>
                        </td>
                        <td>{{ audit.email ?: '-' }}</td>
                        <td>{{ audit.ipAddress ?: '-' }}</td>
                        <td>{{ audit.details ?: '-' }}</td>
                    </tr>
                {% else %}
                    <tr><td colspan="5" class="text-center text-muted py-4">Aucun audit.</td></tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

    {% if auditMaxPages > 1 %}
        <nav class="mt-3">
            <ul class="pagination">
                <li class="page-item {{ auditCurrentPage == 1 ? 'disabled' : '' }}">
                    <a class="page-link" href="{{ path('app_admin_index', { tab:'audits', audit_page: auditCurrentPage - 1, audit_event_type: auditFilters.eventType }) }}">&laquo;</a>
                </li>
                {% for i in 1..auditMaxPages %}
                    <li class="page-item {{ i == auditCurrentPage ? 'active' : '' }}">
                        <a class="page-link" href="{{ path('app_admin_index', { tab:'audits', audit_page: i, audit_event_type: auditFilters.eventType }) }}">{{ i }}</a>
                    </li>
                {% endfor %}
                <li class="page-item {{ auditCurrentPage == auditMaxPages ? 'disabled' : '' }}">
                    <a class="page-link" href="{{ path('app_admin_index', { tab:'audits', audit_page: auditCurrentPage + 1, audit_event_type: auditFilters.eventType }) }}">&raquo;</a>
                </li>
            </ul>
        </nav>
    {% endif %}
</div>