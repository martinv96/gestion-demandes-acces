<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>{% block title %}Gestion des accès{% endblock %}</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="{{ asset('styles/app.css') }}">
</head>

<body class="bg-light">

    <div class="d-flex">

        {# SIDEBAR #}
        <aside class="bg-white border-end vh-100 d-flex flex-column justify-content-between" style="width:260px;">

            {# Logo #}
            <div class="p-4 border-bottom d-flex align-items-center gap-3">
                <img src="{{ asset('images/logo.jpg') }}" alt="Logo mairie" style="width:45px;height:45px;object-fit:contain;">
                <div>
                    <h5 class="mb-0">Mairie</h5>
                    <small class="text-muted">Gestion des accès</small>
                </div>
            </div>

            {# Navigation #}
            <nav class="p-3 flex-grow-1">
                <ul class="nav flex-column">
                    <li class="nav-item mb-2">
                        <a class="nav-link" href="{{ path('app_dashboard') }}">Tableau de bord</a>
                    </li>
                    <li class="nav-item mb-2">
                        <a class="nav-link" href="#">Demandes</a>
                    </li>
                    <li class="nav-item mb-2">
                        <a class="nav-link" href="#">Nouvelle demande</a>
                    </li>
                    <li class="nav-item mb-2">
                        <a class="nav-link" href="#">Administration</a>
                    </li>
                </ul>
            </nav>

            {# User section en bas #}
            <div class="p-4 border-top">
                <div class="mb-3 px-2">
                    <p class="text-sm fw-medium mb-0">Marie Dubois</p>
                    <p class="text-muted small mb-0">Ressources Humaines</p>
                </div>
                <form action="#" method="POST">
                    <button type="submit" class="btn btn-light w-100 d-flex align-items-center justify-content-center gap-2">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-box-arrow-right" viewBox="0 0 16 16">
                            <path fill-rule="evenodd" d="M10 12.5a.5.5 0 0 1-.5-.5v-2h-5a.5.5 0 0 1 0-1h5v-2a.5.5 0 0 1 1 0v2h2.5a.5.5 0 0 1 0 1H11v2a.5.5 0 0 1-.5.5z"/>
                            <path fill-rule="evenodd" d="M4.146 8.354a.5.5 0 0 1 0-.708l3-3a.5.5 0 1 1 .708.708L5.707 7.5H12.5a.5.5 0 0 1 0 1H5.707l2.147 2.146a.5.5 0 0 1-.708.708l-3-3z"/>
                        </svg>
                        Déconnexion
                    </button>
                </form>
            </div>

        </aside>

        {# CONTENU PRINCIPAL #}
        <main class="flex-grow-1 p-4">
            {% block body %}{% endblock %}
        </main>

    </div>

</body>
</html>
