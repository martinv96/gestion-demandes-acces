<!DOCTYPE html>
<html>
	<head>
		<meta charset="UTF-8">
		<title>
			{% block title %}Gestion des accès
			{% endblock %}
		</title>
		{% block stylesheets %}
			<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
			<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
			<link rel="stylesheet" href="{{ asset('styles/app.css') }}">
			<link rel="icon" type="image/svg+xml" href="{{ asset('images/logo/logo-blue.svg') }}">
		{% endblock %}
	</head>

	<body class="app-body">

		<div
			class="app-shell d-flex min-vh-100">

			{# SIDEBAR #}
			<aside
				class="app-sidebar bg-white border-end min-vh-100 d-flex flex-column justify-content-between">

				{# Logo + lien vers dashboard #}
				<a class="nav-link" href="{{ path('app_dashboard') }}">
					<div class="p-4 border-bottom d-flex align-items-center gap-3">
						<img src="{{ asset('images/logo/logo-home.jpg') }}" alt="Logo mairie" class="imageLogo">
						<div>
							<h6 class="titreH6 mb-0">GDAP</h6>
							<p class="text logo-subtitle"><b>G</b>estion <b>D</B>es <b>A</b>ccès du <b>P</b>lessis</p>
						</div>
					</div>
				</a>

				{# Navigation #}
				<nav class="p-3 flex-grow-1">
					<ul class="nav flex-column">
						<li class="nav-item mb-2">
							<a class="nav-link" href="{{ path('app_dashboard') }}">Tableau de bord</a>
						</li>
						<li class="nav-item mb-2">
							<a class="nav-link" href="{{ path('app_list_request') }}">Dernières Demandes</a>
						</li>
						<li class="nav-item mb-2">
							<a class="nav-link" href="{{ path('app_new_request') }}">Nouvelle demande</a>
						</li>
						<li class="nav-item mb-2">
							<a class="nav-link" href="{{ path('app_history') }}">Historique</a>
						</li>
						<li class="nav-item mb-2">
							<a class="nav-link" href="{{ path('app_calendar') }}">Calendrier</a>
						</li>
						<li class="nav-item mb-2">
							<a class="nav-link" href="{{ path('app_my_requests') }}">Mes demandes</a>
						</li>
						{% if is_granted('ROLE_ADMIN') %}
							<li class="nav-item mb-2">
								<a class="nav-link" href="{{ path('app_admin_index') }}">Administrateur</a>
							</li>
						{% endif %}
					</ul>
				</nav>

				{# User section (bas de page) #}
				<div class="p-4 border-top">
				<div class="theme-toggle-wrapper mb-3">
					<button type="button" id="theme-toggle" class="theme-toggle-btn w-100">
						<span class="theme-toggle-icon" aria-hidden="true">☾</span>
						<span class="theme-toggle-label">Passer en sombre</span>
					</button>
				</div>
					{% if app.user %}
						<div class="mb-3 px-2">
							<p class="text-sm text-muted mb-0">Connecté en tant que :</p>
							<p class="text-sm fw-medium mb-0" style="margin-left: 14px;">{{ app.user.displayName }}</p>
						</div>
						<form action="{{ path('app_logout') }}" method="POST">
							<button type="submit" class="btn btn-light w-100 d-flex align-items-center justify-content-center gap-2">
								<img src="{{asset ('images/deconnexion.png')}}" alt="déconnexion" class="ImgDeconnexion">
								Déconnexion
							</button>
						</form>
					{% else %}
						<a href="{{ path('app_login') }}" class="btn btn-primary w-100">Se connecter</a>
					{% endif %}
				</div>
			</aside>

			{# CONTENU PRINCIPAL #}
			<main class="app-main flex-grow-1 p-4 d-flex flex-column">
				<div class="flex-grow-1 d-flex flex-column">
					{% if app.request and app.request.hasSession %}
						{% for type, messages in app.flashes(['success', 'warning', 'danger', 'info']) %}
							{% for message in messages %}
								<div class="alert alert-{{ type }} alert-dismissible fade show" role="alert">
									{{ message|raw }}
									<button type="button" class="btn-close" data-bs-dismiss="alert">&#10006;</button>
								</div>
							{% endfor %}
						{% endfor %}
					{% endif %}
					{% block body %}{% endblock %}
				</div>
			</main>
		</div>

		<script>
			document.addEventListener('click', async function (event) {
				const button = event.target.closest('.js-copy-temp-password');
				if (!button) {
					return;
				}

				let textToCopy = button.getAttribute('data-copy-text') || '';
				if (!textToCopy) {
					const passwordNode = button.parentElement ? button.parentElement.querySelector('.font-monospace') : null;
					textToCopy = passwordNode ? passwordNode.textContent.trim() : '';
				}
				if (!textToCopy) {
					return;
				}

				let copied = false;

				try {
					if (navigator.clipboard && window.isSecureContext) {
						await navigator.clipboard.writeText(textToCopy);
						copied = true;
					}
				} catch (e) {
					copied = false;
				}

				if (!copied) {
					const textarea = document.createElement('textarea');
					textarea.value = textToCopy;
					textarea.setAttribute('readonly', 'readonly');
					textarea.style.position = 'fixed';
					textarea.style.opacity = '0';
					document.body.appendChild(textarea);
					textarea.focus();
					textarea.select();

					try {
						copied = document.execCommand('copy');
					} catch (e) {
						copied = false;
					}

					document.body.removeChild(textarea);
				}

				if (copied) {
					button.textContent = 'Copié';
					button.classList.remove('btn-outline-light');
					button.classList.add('btn-success');
				} else {
					window.prompt('Copie manuelle: Ctrl+C puis Entree', textToCopy);
				}
			});
			(() => {
				const root = document.documentElement;
				const toggle = document.getElementById('theme-toggle');

				if (!toggle) {
					return;
				}

				const label = toggle.querySelector('.theme-toggle-label');
				const icon = toggle.querySelector('.theme-toggle-icon');
				const media = window.matchMedia('(prefers-color-scheme: dark)');

				const getTheme = () => {
					const explicitTheme = root.dataset.theme;
					if (explicitTheme === 'light' || explicitTheme === 'dark') {
						return explicitTheme;
					}

					return media.matches ? 'dark' : 'light';
				};

				const refreshToggle = () => {
					const currentTheme = getTheme();
					const isDark = currentTheme === 'dark';

					toggle.setAttribute('aria-pressed', String(isDark));
					label.textContent = isDark ? 'Passer en clair' : 'Passer en sombre';
					icon.textContent = isDark ? '☀' :'☾';
				};

				toggle.addEventListener('click', () => {
					const nextTheme = getTheme() ==='dark' ? 'light' : 'dark';
					root.dataset.theme = nextTheme;
					localStorage.setItem('theme', nextTheme);
					refreshToggle();
				});

				if (media.addEventListener) {
					media.addEventListener('change', () => {
						if (!localStorage.getItem('theme')) {
							refreshToggle();
						}
					});
				}

			refreshToggle();
			})();
		</script>
		<script>
			
		</script>
		{% block javascripts %}
			<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
			<script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
			<script src="https://cdn.jsdelivr.net/npm/flatpickr/dist/l10n/fr.js"></script>
			<script>
				(() => {
					const savedTheme = localStorage.getItem('theme');
					if (savedTheme === 'light' || savedTheme === 'dark') {
						document.documentElement.dataset.theme = savedTheme;
					}
				})();
			</script>
		{% endblock %}
	</body>
</html>
