<!DOCTYPE html>
<html>
	<head>
		<meta charset="UTF-8">
		<title>
			{% block title %}Gestion des accès
			{% endblock %}
		</title>
		<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
		<link rel="stylesheet" href="{{ asset('styles/app.css') }}">
	</head>

	<body class="bg-light">

		<div
			class="d-flex min-vh-100">

			{# SIDEBAR #}
			<aside
				class="bg-white border-end min-vh-100 d-flex flex-column justify-content-between" style="width:260px;">

				{# Logo #}
				<div class="p-4 border-bottom d-flex align-items-center gap-3">
					<img src="{{ asset('images/logo.jpg') }}" alt="Logo mairie" style="width:45px;height:45px;object-fit:contain;">
					<div>
						<h5 class="mb-0">Mairie</h5>
						<small class="text-muted">Gestion des accès</small>
					</div>
				</div>

				{# Navigation #}
				<nav class="p-3 flex-grow-1">
					<ul class="nav flex-column">
						<li class="nav-item mb-2">
							<a class="nav-link" href="{{ path('app_dashboard') }}">Tableau de bord</a>
						</li>
						<li class="nav-item mb-2">
							<a class="nav-link" href="#">Demandes</a>
						</li>
						<li class="nav-item mb-2">
							<a class="nav-link" href="{{ path('app_new_request') }}">Nouvelle demande</a>
						</li>
						<li class="nav-item mb-2">
							<a class="nav-link" href="#">Administration</a>
						</li>
					</ul>
				</nav>

				{# User section en bas #}
				<div class="p-4 border-top">
					<div class="mb-3 px-2">
						<p class="text-sm fw-medium mb-0">Marie Dubois</p>
						<p class="text-muted small mb-0">Ressources Humaines</p>
					</div>
					<form action="#" method="POST">
						<button type="submit" class="btn btn-light w-100 d-flex align-items-center justify-content-center gap-2">
							<img src="{{asset ('images/deconnexion.png')}}" alt="deconnexion" style="width:20px;height:20px;object-fit:contain;">
							Déconnexion
						</button>
					</form>
				</div>

			</aside>

			{# CONTENU PRINCIPAL #}
			<main class="flex-grow-1 p-4 d-flex flex-column">
				<div
					class="flex-grow-1 d-flex flex-column">
					{# <- nouveau wrapper #}
					{% block body %}{% endblock %}
				</div>
			</main>

		</div>

	</body>
</html>
