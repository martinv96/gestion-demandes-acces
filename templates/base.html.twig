<!DOCTYPE html>
<html>
	<head>

		<meta charset="UTF-8">

		<title>
			{% block title %}Gestion des accès
			{% endblock %}
		</title>

		<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

	</head>

	<body class="bg-light">

		<div
			class="d-flex">

			{# SIDEBAR #}
			<aside class="bg-white border-end vh-100" style="width:260px;">

				<div class="p-4 border-bottom d-flex align-items-center gap-3">

					<img src="{{ asset('images/logo.jpg') }}" alt="Logo mairie" style="width:45px;height:45px;object-fit:contain;">

					<div>
						<h5 class="mb-0">Mairie</h5>
						<small class="text-muted">Gestion des accès</small>
					</div>

				</div>


				<nav class="p-3">

					<ul class="nav flex-column">

						<li class="nav-item mb-2">
							<a class="nav-link" href="{{ path('app_dashboard') }}">
								Tableau de bord
							</a>
						</li>

						<li class="nav-item mb-2">
							<a class="nav-link" href="#">
								Demandes
							</a>
						</li>

						<li class="nav-item mb-2">
							<a class="nav-link" href="#">
								Nouvelle demande
							</a>
						</li>

						<li class="nav-item mb-2">
							<a class="nav-link" href="#">
								Administration
							</a>
						</li>

					</ul>

				</nav>

			</aside>

			{# CONTENU PRINCIPAL #}

			<main class="flex-grow-1 p-4"> {% block body %}{% endblock %}

				</main>

			</div>

		</body>
	</html>
