{% extends 'base.html.twig' %}

{% block title %}Changer votre mot de passe{% endblock %}

{% block body %}
<div class="d-flex align-items-center justify-content-center" style="min-height: 70vh;">
    <div class="card border-0 shadow-sm" style="width: 100%; max-width: 440px;">
        <div class="card-body p-4">
            <h4 class="mb-1">Changez votre mot de passe</h4>
            <p class="text-muted small mb-4">
                Votre compte vient d'être créé. Vous devez définir un nouveau mot de passe avant de continuer.
            </p>

            {% for flash_type, messages in app.flashes %}
                {% for message in messages %}
                    <div class="alert alert-{{ flash_type == 'danger' ? 'danger' : 'success' }} py-2">{{ message }}</div>
                {% endfor %}
            {% endfor %}

            <form method="post" action="{{ path('app_force_change_password') }}">
                <input type="hidden" name="_token" value="{{ csrf_token('force_change_password') }}">

                <div class="mb-3">
                    <label class="form-label">Nouveau mot de passe</label>
                    <input type="password" class="form-control" name="new_password"
                        placeholder="••••••••" required minlength="8" autocomplete="new-password">
                </div>
                <div class="mb-4">
                    <label class="form-label">Confirmer le mot de passe</label>
                    <input type="password" class="form-control" name="confirm_password"
                        placeholder="••••••••" required minlength="8" autocomplete="new-password">
                </div>

                <button type="submit" class="btn btn-primary w-100">Enregistrer le mot de passe</button>
            </form>
        </div>
    </div>
</div>
{% endblock %}
