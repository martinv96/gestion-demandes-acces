{% extends 'base.html.twig' %}

{% block title %}Nouvelle demande
{% endblock %}

{% block body %}
	<div class="container">
		{% if saved %}
			<div class="alert alert-success" role="alert">
				La demande a été créée et les ressources sélectionnées ont été associées.
				<button type="button" class="close">X</button>
			</div>
		{% endif %}

		<div class="mb-4">
			<h1 class="h3 d-flex align-items-center gap-2">
				<svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" fill="currentColor" class="bi bi-file-plus" viewbox="0 0 16 16">
					<path d="M8 6a.5.5 0 0 1 .5.5V8H10a.5.5 0 0 1 0 1H8.5v1.5a.5.5 0 0 1-1 0V9H6a.5.5 0 0 1 0-1h1.5V6.5A.5.5 0 0 1 8 6z"/>
					<path d="M14 4.5V14a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V2a2 2 0 0 1 2-2h6.5L14 4.5zM13 4H9V0H4a1 1 0 0 0-1 1v12a1 1 0 0 0 1 1h8a1 1 0 0 0 1-1V4z"/>
				</svg>
				Nouvelle demande d'accès
			</h1>
			<p class="text-muted mb-0">Créer une demande d'accès pour un agent</p>
		</div>

		{{ form_start(form, {'attr': {
			'class': 'request-form', 
			'enctype': 'multipart/form-data',
			'data-new-request': '1',
			'data-type-name': form.type.vars.full_name,
			'data-parent-request-id': form.parentRequest.vars.id,
			'data-civility-id': form.civility.vars.id,
			'data-firstname-id': form.firstname.vars.id,
			'data-lastname-id': form.lastname.vars.id,
			'data-email-id': form.email.vars.id,
			'data-service-id': form.service.vars.id,
			'data-job-title-id': form.jobTitle.vars.id,
			'data-arrival-date-id': form.arrivalDate.vars.id,
			'data-departure-date-id': form.departureDate.vars.id,
			'data-commentary-id': form.commentary.vars.id,
			'data-clothing-size-id': form.clothingSize is defined ? form.clothingSize.vars.id : '',
			'data-shoe-size-id': form.shoeSize is defined ? form.shoeSize.vars.id : '',
			'data-phone-type-name': form.phoneTypes.vars.full_name
			}
			}) }}

		{% if form.vars.errors|length > 0 %}
			<div class="alert alert-danger form-errors-global">
				{{ form_errors(form) }}
			</div>
		{% endif %}


		{# type de demande #}
		<div class="card request-form-card mb-4">
			<div class="card-header">Type de demande</div>
			<div class="card-body request-choice-group">
				{{ form_row(form.type) }}
			</div>
		</div>

		{# modal: demande d'origine #}
		<div class="modal fade" id="parentRequestModal" tabindex="-1" aria-labelledby="parentRequestModalLabel" aria-hidden="true">
			<div class="modal-dialog">
				<div class="modal-content">
					<div class="modal-header">
						<h5 class="modal-title" id="parentRequestModalLabel">Sélectionner la demande d'origine</h5>
						<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
					</div>
					<div class="modal-body">
						<p class="text-muted mb-3">
							Ce champ est obligatoire pour une modification ou une fermeture.
						</p>
						{{ form_row(form.parentRequest) }}
					</div>
					<div class="modal-footer">
						<button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Annuler</button>
						<button type="button" class="btn btn-primary" id="confirmParentRequestBtn" data-bs-dismiss="modal">Valider</button>
					</div>
				</div>
			</div>
		</div>


		{# informations agent #}
		<div class="card request-form-card mb-4">
			<div class="card-header">Informations agent</div>
			<div class="card-body">
				<div class="row g-3">
					<div class="col-md-6">
						{{ form_row(form.civility) }}
					</div>
					<div class="col-md-6">
						{{ form_row(form.firstname) }}
					</div>
					<div class="col-md-6">
						{{ form_row(form.lastname) }}
					</div>
					<div class="col-md-6">
						{{ form_row(form.email) }}
					</div>
					<div class="col-md-6">
						{{ form_row(form.service) }}
					</div>
					<div class="col-md-6">
						{{ form_row(form.jobTitle) }}
					</div>
					{% if isServiceTechniqueUser|default(false) %}
						<div class="col-md-6">
							{{ form_row(form.clothingSize) }}
						</div>
						<div class="col-md-6">
							{{ form_row(form.shoeSize) }}
						</div>
					{% endif %}
					<div class="col-md-6">
						{{ form_row(form.arrivalDate) }}
					</div>
					<div class="col-md-6">
						{{ form_row(form.departureDate) }}
					</div>
				</div>
			</div>
		</div>

		{% if form.replaceePar is defined %}
			<div class="card request-form-card mb-4">
				<div class="card-header">L'agent remplace (Optionnel)</div>
				<div class="card-body">
					<div class="row g-3">
						<div class="card-body">
							{{ form_row(form.replaceePar) }}
						</div>
					</div>
				</div>
			</div>
		{% endif %}

		{# récapitulatif demande d'origine #}
		<div class="card request-form-card mb-4 d-none" id="parent-request-summary-card">
			<div class="card-header">Récapitulatif demande d’origine</div>
			<div class="card-body">
				<div class="row g-3">
					<div class="col-md-6">
						<strong>Agent :</strong>
						<span id="summary-agent">-</span>
					</div>
					<div class="col-md-6">
						<strong>Service :</strong>
						<span id="summary-service">-</span>
					</div>
					<div class="col-md-6">
						<strong>Date d’arrivée :</strong>
						<span id="summary-arrival">-</span>
					</div>
					<div class="col-md-6">
						<strong>Date de départ :</strong>
						<span id="summary-departure">-</span>
					</div>
					<div class="col-12">
						<strong>Commentaire :</strong>
						<span id="summary-commentary">-</span>
					</div>
					<div class="col-md-6">
						<strong>Logiciels :</strong>
						<ul class="mb-0" id="summary-logiciels"></ul>
					</div>
					<div class="col-md-6">
						<strong>Matériels :</strong>
						<ul class="mb-0" id="summary-materiels"></ul>
					</div>
				</div>
			</div>
		</div>

		{# accès logiciels #}
		<div class="card request-form-card mb-4" id="logiciels-card">
			<div class="card-header">Accès logiciels</div>
			<div class="card-body request-resource-body">
				<div class="request-checkbox-grid request-resource-grid">
					{{ form_widget(form.logiciels) }}
				</div>
				<div class="field-errors">{{ form_errors(form.logiciels) }}</div>
			</div>
		</div>

		{% set hasTechniqueAccess = isServiceTechniqueUser|default(false) %}

		<div class="card request-form-card mb-4" id="materiel-card">
			<div class="card-header">Matériel</div>
			<div
				class="card-body request-resource-body">

				{# SECTION TECHNIQUE : Affichée SEULEMENT pour le Service Technique #}
				{% if hasTechniqueAccess %}
					<h6 class="mb-2">Service technique (EPI, badge, jeu de clés)</h6>
					<div class="request-checkbox-grid request-resource-grid mb-3">
						{% for child in form.materiels %}
							{% set materialName = (child.vars.label ?? '')|lower %}
							{% set isStMaterial = 'badge' in materialName
                                or 'clé' in materialName
                                or 'cle' in materialName
                                or 'casque' in materialName
                                or 'gilet' in materialName
                                or 'chaussure' in materialName
                                or 'pantalon' in materialName
                                or 'veste' in materialName
                                or 'gant' in materialName
                                or 'lunette' in materialName
                                or 'harnais' in materialName
                                or 'masque' in materialName
                                or 'protection' in materialName %}
							{% if isStMaterial %}
								{{ form_widget(child) }}
							{% endif %}
						{% endfor %}
					</div>
					<hr>
					{# Une petite barre de séparation si le reste suit #}
				{% endif %}

				{# SECTION AUTRES MATÉRIELS : Visible par tout le monde #}
				<h6 class="mb-2">Autres matériels</h6>
				<div class="request-checkbox-grid request-resource-grid">
					{% for child in form.materiels %}
						{% set materialName = (child.vars.label ?? '')|lower %}
						{% set isStMaterial = 'badge' in materialName
                            or 'clé' in materialName
                            or 'cle' in materialName
                            or 'casque' in materialName
                            or 'gilet' in materialName
                            or 'chaussure' in materialName
                            or 'pantalon' in materialName
                            or 'veste' in materialName
                            or 'gant' in materialName
                            or 'lunette' in materialName
                            or 'harnais' in materialName
                            or 'masque' in materialName
                            or 'protection' in materialName %}

						{# On affiche ici uniquement ce qui n'appartient PAS à la liste technique ci-dessus #}
						{% if not isStMaterial %}
							{{ form_widget(child) }}
						{% endif %}
					{% endfor %}
				</div>

				<div id="phone-type-wrapper" class="mt-3 d-none">
					{{ form_row(form.phoneTypes) }}
				</div>

				<div class="field-errors">{{ form_errors(form.materiels) }}</div>
				<div class="field-errors">{{ form_errors(form.phoneTypes) }}</div>
				{% do form.materiels.setRendered %}
			</div>
		</div>

		<div class="card request-form-card mb-4">
			<div class="card-header">Pièce jointe (optionnel)</div>
			<div class="card-body">
				<div class="custom-file-wrapper mb-2">
					{{ form_widget(form.pieceJointe, {
                'attr': {
                    'class': 'custom-file-input',
                    'style': 'display:none;'
                }
            }) }}
					<label for="{{ form.pieceJointe.vars.id }}" class="custom-file-label-btn">Sélectionner un fichier</label>
					<span id="file-name" class="custom-file-label-text">Aucun fichier sélectionné</span>
				</div>
				{{ form_errors(form.pieceJointe) }}
			</div>
		</div>

		{# commentaires #}
		<div class="card request-form-card mb-4">
			<div class="card-header">Commentaires</div>
			<div class="card-body">
				{{ form_row(form.commentary) }}
			</div>
		</div>

		{# parcours de validation #}
		<div class="card request-form-card mb-4">
			<div class="card-body">
				<div class="request-actions">
					{% if is_granted('ROLE_RH') %}
						<button type="submit" class="btn btn-workflow">Validation RH</button>
					{% elseif is_granted('ROLE_ST') %}
						<button type="submit" class="btn btn-workflow">Validation ST</button>
					{% elseif is_granted('ROLE_DSI') %}
						<button type="submit" class="btn btn-workflow">Validation DSI</button>
					{% else %}
						<button type="submit" class="btn btn-primary">Créer la demande</button>
					{% endif %}

					<a href="{{ path('app_list_request') }}" class="btn btn-outline-secondary request-cancel">Annuler</a>
				</div>
			</div>
		</div>
		{{ form_end(form) }}
	</div>

	<script src="{{ asset('js/new_request.js') }}" defer></script>
{% endblock %}
