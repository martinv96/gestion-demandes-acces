{% extends 'base.html.twig' %}

{% block title %}Nouvelle demande{% endblock %}

{% block body %}
    <div class="container-fluid">
        {% if saved %}
            <div class="alert alert-success" role="alert">
                La demande a été créée et les ressources sélectionnées ont été associées.
            </div>
        {% endif %}

        <div class="mb-4">
            <h1 class="h3 d-flex align-items-center gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" fill="currentColor" class="bi bi-file-plus" viewBox="0 0 16 16">
                    <path d="M8 6a.5.5 0 0 1 .5.5V8H10a.5.5 0 0 1 0 1H8.5v1.5a.5.5 0 0 1-1 0V9H6a.5.5 0 0 1 0-1h1.5V6.5A.5.5 0 0 1 8 6z"/>
                    <path d="M14 4.5V14a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V2a2 2 0 0 1 2-2h6.5L14 4.5zM13 4H9V0H4a1 1 0 0 0-1 1v12a1 1 0 0 0 1 1h8a1 1 0 0 0 1-1V4z"/>
                </svg>
                Nouvelle demande d'accès
            </h1>
            <p class="text-muted mb-0">Créer une demande d'accès pour un agent</p>
        </div>

        {{ form_start(form, {'attr': {'class': 'request-form'}}) }}

            {% if form.vars.errors|length > 0 %}
                <div class="alert alert-danger form-errors-global">
                    {{ form_errors(form) }}
                </div>
            {% endif %}

            <div class="card request-form-card mb-4">
                <div class="card-header">Informations agent</div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            {{ form_row(form.civility) }}
                        </div>
                        <div class="col-md-6">
                            {{ form_row(form.firstname) }}
                        </div>
                        <div class="col-md-6">
                            {{ form_row(form.lastname) }}
                        </div>
                        <div class="col-md-6">
                            {{ form_row(form.email) }}
                        </div>
                        <div class="col-md-6">
                            {{ form_row(form.service) }}
                        </div>
                        <div class="col-md-6">
                            {{ form_row(form.jobTitle) }}
                        </div>
                        <div class="col-md-6">
                            {{ form_row(form.arrivalDate) }}
                        </div>
                        <div class="col-md-6">
                            {{ form_row(form.departureDate) }}
                        </div>
                    </div>
                </div>
            </div>

            <div class="card request-form-card mb-4">
                <div class="card-header">Type de demande</div>
                <div class="card-body request-choice-group">
                    {{ form_row(form.type) }}
                </div>
            </div>

            <div class="card request-form-card mb-4" id="logiciels-card">
                <div class="card-header">Accès logiciels</div>
                <div class="card-body request-checkbox-grid">
                    {{ form_widget(form.logiciels) }}
                    <div class="field-errors">{{ form_errors(form.logiciels) }}</div>
                </div>
            </div>

            <div class="card request-form-card mb-4" id="materiel-card">
                <div class="card-header">Matériel</div>
                <div class="card-body request-checkbox-grid">
                    {{ form_widget(form.materiels) }}
                    <div class="field-errors">{{ form_errors(form.materiels) }}</div>
                </div>
            </div>

            <div class="card request-form-card mb-4">
                <div class="card-header">Commentaires</div>
                <div class="card-body">
                    {{ form_row(form.commentary) }}
                </div>
            </div>

            <div class="card request-form-card mb-4">
                <div class="card-body">
                    <div class="request-actions">
                        {% if is_granted('ROLE_RH') %}
                            <button type="submit" class="btn btn-workflow">Validation RH</button>
                        {% elseif is_granted('ROLE_ST') %}
                            <button type="submit" class="btn btn-workflow">Validation DGA-ST</button>
                        {% elseif is_granted('ROLE_DSI') %}
                            <button type="submit" class="btn btn-workflow">Validation DSI</button>
                        {% else %}
                            <button type="submit" class="btn btn-primary">Créer la demande</button>
                        {% endif %}

                        <a href="{{ path('app_list_request') }}" class="btn btn-outline-secondary request-cancel">Annuler</a>
                    </div>
                </div>
            </div>

        {{ form_end(form) }}
    </div>

    <script>
        const typeRadios = document.querySelectorAll('input[name="{{ form.type.vars.full_name }}"]');
        const logicielsCard = document.getElementById('logiciels-card');
        const materielCard = document.getElementById('materiel-card');

        function toggleResourceCards(value) {
            const hidden = value === 'fermeture';
            logicielsCard.style.display = hidden ? 'none' : 'block';
            materielCard.style.display = hidden ? 'none' : 'block';
        }

        typeRadios.forEach((radio) => {
            radio.addEventListener('change', function () {
                toggleResourceCards(this.value);
            });
        });

        const checkedRadio = document.querySelector('input[name="{{ form.type.vars.full_name }}"]:checked');
        if (checkedRadio) {
            toggleResourceCards(checkedRadio.value);
        }
    </script>
{% endblock %}