{% extends 'base.html.twig' %}

{% block title %}Accès Refusé{% endblock %}

{% block body %}
<div class="container py-5 text-center">
    <h1 class="display-1 fw-bold text-warning">403</h1>
    <h2 class="mb-4">Accès Interdit</h2>
    <p class="lead">Vous n'avez pas les permissions nécessaires pour accéder à cette page.</p>
    <p class="text-muted">Si vous pensez qu'il s'agit d'une erreur, contactez le service informatique.</p>
    <a href="{{ path('app_dashboard') }}" class="btn btn-outline-warning mt-3">Retour à l'accueil</a>
</div>
{% endblock %}