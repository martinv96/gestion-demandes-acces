{% extends 'base.html.twig' %}

{% block title %}Tableau de bord
{% endblock %}

{% block body %}

	<div class="container mt-5">

		<h1 class="mb-2">Tableau de bord</h1>
		<p class="text-muted mb-4">Vue d'ensemble des demandes d'accès</p>

		<div class="row mb-4">

			{% for stat in stats %}
				<div class="col-md-4">
					<div class="card shadow-sm dashboard-stat-card">
						<div class="card-body dashboard-stat-body">
							<div>
								<h6 class="text-muted mb-1">{{ stat.title }}</h6>
								<h2 class="mb-0">{{ stat.value }}</h2>
							</div>
							<img class="dashboard-stat-icon" src="{{ asset(stat.icon) }}" alt="{{ stat.title }}">
						</div>
					</div>
				</div>
			{% endfor %}

		</div>

		<div class="card">

			<div class="card-header d-flex justify-content-between">

				<h5>Demandes récentes</h5>

				<a href="{{ path('app_history') }}" class="btn btn-outline-primary btn-sm">
					Voir toutes les demandes
				</a>

			</div>

			<div class="card-body">

				<table class="table">

					<thead>

						<tr>
							<th>N° Demande</th>
							<th>Agent</th>
							<th>Service</th>
							<th>Type</th>
							<th>Statut</th>
							<th>Date</th>
							<th class="text-center">Action</th>
						</tr>

					</thead>

					<tbody>

						{% for request in recentRequests %}

							<tr>

								<td>{{ request.reference }}</td>
								<td>
									{% if request.agent %}
										{{ request.agent.firstname }}
										{{ request.agent.lastname }}
									{% else %}
										-
									{% endif %}
								</td>
								<td>
									{% if request.agent and request.agent.service %}
										{{ request.agent.service.name }}
									{% else %}
										-
									{% endif %}
								</td>
								<td>{{ request.type|capitalize }}</td>
								<td>
									{% set statusMap = {
										'en_attente_rh':  {'label': 'En attente RH', 'color': 'warning'},
										'en_attente_st':  {'label': 'En attente DGA-ST', 'color': 'warning'},
										'en_attente_dsi': {'label': 'En attente DSI', 'color': 'warning'},
										'traitee':        {'label': 'Traitée', 'color': 'success'},
										'refusee_rh':     {'label': 'Refusée RH', 'color': 'danger'},
										'refusee_st':     {'label': 'Refusée DGA-ST', 'color': 'danger'},
										'refusee_dsi':    {'label': 'Refusée DSI', 'color': 'danger'}
									} %}
									{% set statusConfig = statusMap[request.status] ?? {'label': request.status|replace({'_': ' '}), 'color': 'secondary'} %}
									<span class="badge text-bg-{{ statusConfig.color }}">{{ statusConfig.label }}</span>
								</td>
								<td>{{ request.creationDate ? request.creationDate|date('d/m/Y') : '-' }}</td>

								<td class="text-center">
									<a href="{{ path('app_request_show', {id: request.id}) }}">
										<img src="{{ asset('images/icones/chercher1.png') }}" alt="Voir" style="width:24px;height:24px;object-fit:contain;">
									</a>
								</td>
							</tr>

						{% else %}
							<tr>
								<td colspan="7" class="text-center text-muted">Aucune demande recente</td>
							</tr>
						{% endfor %}

					</tbody>
				</table>
			</div>
		</div>
	</div>

{% endblock %}
