{% extends 'base.html.twig' %}

{% block title %}Demande
	{{ requestEntity.reference }}
{% endblock %}

{% import 'list_request/includes/_macros.html.twig' as macros %}

{% block body %}

	{# Contenu principal #}
	<div
		class="container-fluid request-detail-container">

		{# Historique des changements #}
		{% set history = requestEntity.requestId|sort((a, b) => a.date <=> b.date) %}
		{% set createdAt = requestEntity.creationDate %}
		{% set createdBy = requestEntity.author ? requestEntity.author.displayName : 'Service RH' %}
		{% set rhStepDone = requestEntity.status in ['en_attente_validation', 'en_attente_st', 'en_attente_dsi', 'traitee', 'refusee_rh', 'en_attente_traitement', 'refusee_st', 'refusee_dsi'] %}
		{% set stStepDone = requestEntity.status in ['en_attente_dsi', 'traitee', 'refusee_st', 'refusee_dsi', 'en_attente_traitement'] %}
		{% set dsiStepDone = requestEntity.status in ['traitee', 'refusee_dsi', 'en_attente_traitement'] %}
		{% set treatedStepDone = requestEntity.status == 'traitee' %}
		{% set rhValidatedAt = null %}
		{% set stValidatedAt = null %}
		{% set dsiValidatedAt = null %}
		{% set selectedSoftwareNames = requestEntity.ressources|filter(r => r.category == 'logiciel')|map(r => r.name) %}
		{% set selectedMaterialNames = requestEntity.ressources|filter(r => r.category == 'materiel')|map(r => r.name) %}
		{% set selectedRessourceIds = requestEntity.ressources|map(r => r.id) %}
		{% set selectedMaterialNamesLower = selectedMaterialNames|map(name => name|lower) %}
		{% set selectedServiceId = selectedServiceId ?? null %}
		{% for entry in history %}
			{% set entryRoles = entry.user ? entry.user.roles : [] %}
			{% set isUndoEntry = entry.commentary starts with 'Annulation de décision' %}
			{% set isModificationEntry = entry.commentary starts with 'Modification des informations :' %}

			{% if isUndoEntry %}
				{% if 'ROLE_RH' in entryRoles %}
					{% set rhStepDone = false %}
					{% set rhValidatedAt = null %}
				{% endif %}
				{% if 'ROLE_ST' in entryRoles %}
					{% set stStepDone = false %}
					{% set stValidatedAt = null %}
				{% endif %}
				{% if 'ROLE_DSI' in entryRoles %}
					{% set dsiStepDone = false %}
					{% set dsiValidatedAt = null %}
				{% endif %}
			{% endif %}

			{% if not isUndoEntry and not isModificationEntry and 'ROLE_RH' in entryRoles and entry.newStatus in ['en_attente_validation', 'en_attente_st'] and rhValidatedAt is null %}
				{% set rhValidatedAt = entry.date %}
			{% endif %}

			{% if not isModificationEntry and entry.newStatus == 'en_attente_st' and rhValidatedAt is null %}
				{% set rhValidatedAt = entry.date %}
			{% endif %}
			{% if not isModificationEntry and entry.newStatus == 'en_attente_dsi' and stValidatedAt is null %}
				{% set stValidatedAt = entry.date %}
			{% endif %}
			{% if not isModificationEntry and entry.newStatus == 'traitee' and dsiValidatedAt is null %}
				{% set dsiValidatedAt = entry.date %}
			{% endif %}

			{% if not isUndoEntry and not isModificationEntry and entry.oldStatus starts with 'en_attente_' and entry.oldStatus != 'en_attente_rh' and entry.newStatus in ['en_attente_validation', 'traitee', 'en_attente_traitement'] %}
				{% if 'ROLE_ST' in entryRoles %}
					{% set stStepDone = true %}
					{% if stValidatedAt is null %}
						{% set stValidatedAt = entry.date %}
					{% endif %}
				{% endif %}
				{% if 'ROLE_DSI' in entryRoles %}
					{% set dsiStepDone = true %}
					{% if dsiValidatedAt is null %}
						{% set dsiValidatedAt = entry.date %}
					{% endif %}
				{% endif %}
			{% endif %}
		{% endfor %}
		{% if rhValidatedAt %}
			{% set rhStepDone = true %}
		{% endif %}
		{% set processingDelayDays = null %}
		{% if requestEntity.creationDate %}
			{% set nowTs = 'now'|date('U') %}
			{% set createdTs = requestEntity.creationDate|date('U') %}
			{% set statusStartTs = createdTs %}
			{% if history is not empty %}
				{% set currentStatusHistory = history|filter(h => h.newStatus == requestEntity.status)|last %}
				{% if currentStatusHistory and currentStatusHistory.date %}
					{% set statusStartTs = currentStatusHistory.date|date('U') %}
				{% endif %}
			{% endif %}
			{% set diffSeconds = nowTs - statusStartTs %}
			{% if diffSeconds < 0 %}
				{% set diffSeconds = 0 %}
			{% endif %}
			{% set processingDelayDays = (diffSeconds / 86400)|round(0, 'floor') %}
		{% endif %}

		{# En-tête #}
		<div class="d-flex justify-content-between align-items-center mb-4">
			<div>
				<h1 class="h3 mb-1">Demande
					{{ requestEntity.reference }}</h1>
				<p class="text-muted mb-0">
					{{ macros.statusBadge(requestEntity.status) }}
				</p>
			</div>
			<a href="{{ path('app_list_request') }}" class="btn btn-outline-secondary">Retour à la liste</a>
		</div>

		{% if isBlockedByMissingValidator %}
			<div class="alert alert-warning mb-4" role="alert">
				Cette demande est bloquée car aucun compte actif n'existe pour
				{{ missingValidatorLabel }}.
																								Veuillez contacter le service RH pour débloquer la demande.
			</div>
		{% endif %}

		<div class="row g-4 align-items-start request-detail-layout">
			<div class="col-xl-8 col-xxl-9 order-2 order-xl-1">
				{% if canEditRequestInfo %}
					<form method="post" action="{{ path('app_request_update_info', {id: requestEntity.id}) }}" class="row g-4">
						<input type="hidden" name="_token" value="{{ csrf_token('request_edit_' ~ requestEntity.id) }}">
						<input type="hidden" name="version" value="{{ requestEntity.version }}">
					{% else %}
						<div class="row g-4">
						{% endif %}

						{# Infos générales #}
						<div class="col-lg-6">
							<div class="card h-100">
								<div class="card-header">Informations générales</div>
								<div class="card-body">
									{% if canEditRequestInfo %}
										<div class="row g-3">
											<div class="col-12">
												<label class="form-label">Type de demande</label>
												<div class="form-check">
													<input class="form-check-input" type="radio" name="type" id="inline_type_ouverture" value="ouverture" {{ requestEntity.type == 'ouverture' ? 'checked' : '' }}>
													<label class="form-check-label" for="inline_type_ouverture">Ouverture - Nouveau collaborateur</label>
												</div>
												<div class="form-check">
													<input class="form-check-input" type="radio" name="type" id="inline_type_modification" value="modification" {{ requestEntity.type == 'modification' ? 'checked' : '' }}>
													<label class="form-check-label" for="inline_type_modification">Modification - Changement de service ou fonction</label>
												</div>
												<div class="form-check">
													<input class="form-check-input" type="radio" name="type" id="inline_type_fermeture" value="fermeture" {{ requestEntity.type == 'fermeture' ? 'checked' : '' }}>
													<label class="form-check-label" for="inline_type_fermeture">Fermeture - Depart du collaborateur</label>
												</div>
											</div>
											<div class="col-md-6">
												<label for="inline_date_arrivee" class="form-label">Date d'arrivée *</label>
												<input type="date" class="form-control" id="inline_date_arrivee" name="date_arrivee" value="{{ requestEntity.arrivalDate ? requestEntity.arrivalDate|date('Y-m-d') : '' }}" required>
											</div>
											<div class="col-md-6">
												<label for="inline_date_depart" class="form-label">Date de départ</label>
												<input type="date" class="form-control" id="inline_date_depart" name="date_depart" value="{{ requestEntity.departureDate ? requestEntity.departureDate|date('Y-m-d') : '' }}">
											</div>
											<div class="col-md-6">
												<label class="form-label">Statut</label>
												<div>{{ macros.statusBadge(requestEntity.status) }}</div>
											</div>
											<div class="col-md-6">
												<label class="form-label">Créée le</label>
												<div class="form-control-plaintext">{{ requestEntity.creationDate ? requestEntity.creationDate|date('d/m/Y H:i') : '-' }}</div>
											</div>
											<div class="col-md-6">
												<label class="form-label">Mise à jour</label>
												<div class="form-control-plaintext">{{ requestEntity.updateDate ? requestEntity.updateDate|date('d/m/Y H:i') : '-' }}</div>
											</div>
											{% if requestEntity.status not in ['traitee', 'refusee_rh', 'refusee_st', 'refusee_dsi'] %}
												<div class="col-md-6">
													<label class="form-label">Délai de traitement</label>
													<div
														class="form-control-plaintext">
														{% if processingDelayDays is not null %}
															En attente depuis :
															{{ processingDelayDays }}
															{{ processingDelayDays > 1 ? 'jours' : 'jour' }}
														{% else %}
															<span class="text-muted">-</span>
														{% endif %}
													</div>
												</div>
											{% endif %}

										</div>
									{% else %}
										<dl class="row mb-0">
											<dt class="col-sm-4">Type</dt>
											<dd class="col-sm-8 text-capitalize">{% set typeMap = {
																					'ouverture': 'Arrivée',
																					'modification': 'Changement de poste / Droits',
																					'fermeture': 'Départ'
																				} %}
												{{ typeMap[requestEntity.type] ?? requestEntity.type|capitalize }}</dd>
											<dt class="col-sm-4">Statut</dt>
											<dd class="col-sm-8">{{ macros.statusBadge(requestEntity.status) }}</dd>
											<dt class="col-sm-4">Arrivée</dt>
											<dd class="col-sm-8">{{ requestEntity.arrivalDate ? requestEntity.arrivalDate|date('d/m/Y') : '-' }}</dd>
											<dt class="col-sm-4">Départ</dt>
											<dd class="col-sm-8">{{ requestEntity.departureDate ? requestEntity.departureDate|date('d/m/Y') : '-' }}</dd>
											<dt class="col-sm-4">Téléphone</dt>
											<dd class="col-sm-8">
												{% set phoneTypes = requestEntity.phoneTypes %}
												{{ phoneTypes is not empty ? phoneTypes|map(v => v|capitalize)|join(', ') : '-' }}
											</dd>
											<dt class="col-sm-4">Créée le</dt>
											<dd class="col-sm-8">{{ requestEntity.creationDate ? requestEntity.creationDate|date('d/m/Y H:i') : '-' }}</dd>
											<dt class="col-sm-4">Mise à jour</dt>
											<dd class="col-sm-8">{{ requestEntity.updateDate ? requestEntity.updateDate|date('d/m/Y H:i') : '-' }}</dd>
											{% if requestEntity.status not in ['traitee', 'refusee_rh', 'refusee_st', 'refusee_dsi'] %}
												<dt class="col-sm-4">Délai de traitement</dt>
												<dd class="col-sm-8">
													{% if processingDelayDays is not null %}
														En attente depuis : {{ processingDelayDays }}
														{{ processingDelayDays > 1 ? 'jours' : 'jour' }}
													{% else %}
														<span class="text-muted">-</span>
													{% endif %}
												</dd>
											{% endif %}
										</dl>
									{% endif %}
								</div>
								{% if requestEntity.pieceJointe %}
									<div class="custom-file-wrapper mt-2">
										<a href="{{ asset('uploads/pieces_jointes/' ~ requestEntity.pieceJointe) }}" target="_blank" class="custom-file-label-btn" download>
											<i class="bi bi-paperclip me-1"></i>
											Télécharger la pièce jointe
										</a>
										<span class="custom-file-label-text">{{ requestEntity.pieceJointe }}</span>
									</div>
								</a>
							{% else %}
								<span class="text-muted">Aucune pièce jointe</span>
							{% endif %}
						</div>
					</div>

					{# Agent et service #}
					<div class="col-lg-6">
						<div class="card h-100">
							<div class="card-header">Agent et service</div>
							<div class="card-body">
								{% if requestEntity.agent %}
									{% if canEditRequestInfo %}
										<div class="row g-3">
											<div class="col-md-4">
												<label for="inline_civilite" class="form-label">Civilité *</label>
												<select class="form-select" id="inline_civilite" name="civilite" required>
													<option value="">Selectionner une civilité</option>
													<option value="M." {{ requestEntity.agent.civility == 'M.' ? 'selected' : '' }}>M.</option>
													<option value="Mme" {{ requestEntity.agent.civility == 'Mme' ? 'selected' : '' }}>Mme</option>
													<option value="Mlle" {{ requestEntity.agent.civility == 'Mlle' ? 'selected' : '' }}>Mlle</option>
												</select>
											</div>
											<div class="col-md-4">
												<label for="inline_prenom" class="form-label">Prénom</label>
												<input type="text" class="form-control" id="inline_prenom" name="prenom" value="{{ requestEntity.agent.firstname|capitalize }}" required>
											</div>
											<div class="col-md-4">
												<label for="inline_nom" class="form-label">Nom</label>
												<input type="text" class="form-control" id="inline_nom" name="nom" value="{{ requestEntity.agent.lastname|capitalize }}" required>
											</div>
											<div class="col-md-6">
												<label for="inline_fonction" class="form-label">Fonction</label>
												<input type="text" class="form-control" id="inline_fonction" name="fonction" value="{{ requestEntity.agent.jobTitle ? requestEntity.agent.jobTitle|capitalize : '' }}" required>
											</div>
											<div class="col-md-6">
												<label for="inline_service" class="form-label">Service *</label>
												<select class="form-select" id="inline_service" name="service" required>
													<option value="">Selectionner un service</option>
													{% for service in availableServices %}
														<option value="{{ service.id }}" {{ selectedServiceId == service.id ? 'selected' : '' }}>{{ service.name }}</option>
													{% endfor %}
												</select>
											</div>
											<div class="col-12">
												<label for="inline_email" class="form-label">Email</label>
												<input type="email" class="form-control" id="inline_email" name="email" value="{{ requestEntity.agent.email ?? '' }}" maxlength="180" autocomplete="off">
											</div>
											<div class="col-md-6">
												<label for="inline_taille_vetements" class="form-label">Taille vêtements</label>
												<input type="text" class="form-control" id="inline_taille_vetements" name="taille_vetements" value="{{ requestEntity.agent.clothingSize ?? '' }}" maxlength="20" placeholder="Ex: M, L, XL">
											</div>
											<div class="col-md-6">
												<label for="inline_taille_chaussures" class="form-label">Pointure</label>
												<input type="text" class="form-control" id="inline_taille_chaussures" name="taille_chaussures" value="{{ requestEntity.agent.shoeSize ?? '' }}" maxlength="20" placeholder="Ex: 42">
											</div>
										</div>
									{% else %}
										<dl class="row mb-0">
											<dt class="col-sm-4">Agent</dt>
											<dd class="col-sm-8">{{ requestEntity.agent.firstname|capitalize }}
												{{ requestEntity.agent.lastname|capitalize }}</dd>
											<dt class="col-sm-4">Fonction</dt>
											<dd class="col-sm-8">{{ requestEntity.agent.jobTitle ? requestEntity.agent.jobTitle|capitalize : '-' }}</dd>
											<dt class="col-sm-4">Service</dt>
											<dd class="col-sm-8">{{ requestEntity.agent.service ? requestEntity.agent.service.name : '-' }}</dd>
											<dt class="col-sm-4">Email</dt>
											<dd class="col-sm-8">{{ requestEntity.agent.email ?: '-' }}</dd>
											<dt class="col-sm-4">Taille vêtements</dt>
											<dd class="col-sm-8">{{ requestEntity.agent.clothingSize ?: '-' }}</dd>
											<dt class="col-sm-4">Pointure</dt>
											<dd class="col-sm-8">{{ requestEntity.agent.shoeSize ?: '-'}}</dd>
										</dl>
									{% endif %}
								{% else %}
									<p class="text-muted mb-0">Aucun agent associé.</p>
								{% endif %}
							</div>
						</div>
					</div>

					{# Ressources #}
					<div class="col-12">
						<div class="card">
							<div class="card-header">Ressources associées</div>
							<div class="card-body">
								<div class="resource-status-grid">
									<div class="resource-status-block">
										<h3 class="resource-status-title">Accès logiciels</h3>
										{% if canEditRequestInfo %}
											<div class="row g-2">
												{% for logiciel in availableLogiciels %}
													<div class="col-md-6">
														<div class="form-check">
															<input class="form-check-input" type="checkbox" name="logiciels[]" id="inline_logiciel_{{ loop.index }}" value="{{ logiciel.name }}" {{ logiciel.name in selectedSoftwareNames ? 'checked' : '' }}>
															<label class="form-check-label" for="inline_logiciel_{{ loop.index }}">{{ logiciel.name }}</label>
														</div>
													</div>
												{% else %}
													<p class="text-muted mb-0">Aucun logiciel actif configuré.</p>
												{% endfor %}
											</div>
										{% else %}
											<ul class="resource-status-list">
												{% for logiciel in allLogiciels %}
													{% set isAssigned = logiciel.id in selectedRessourceIds %}
													<li class="resource-status-row">
														<span class="resource-status-name">{{ logiciel.name }}</span>
														<span class="resource-status-pill {{ isAssigned ? 'is-assigned' : 'is-unassigned' }}">{{ isAssigned ? 'attribué' : 'non attribué' }}</span>
													</li>
												{% else %}
													<li class="resource-status-empty">Aucun logiciel actif configuré.</li>
												{% endfor %}
											</ul>
										{% endif %}
									</div>

									<div class="resource-status-block">
										<h3 class="resource-status-title">Accès matériels</h3>
										{% if canEditRequestInfo %}
											<h6 class="mb-2">Service technique (EPI, badge, jeu de clés)</h6>
											<div class="row row-cols-2 g-2 mb-3">
												{% for materiel in availableMateriels %}
													{% set materialName = materiel.name|lower %}
													{% set isStMaterial = 'badge' in materialName
															or 'clé' in materialName
															or 'cle' in materialName
															or 'casque' in materialName
															or 'gilet' in materialName
															or 'chaussure' in materialName
															or 'pantalon' in materialName
															or 'veste' in materialName
															or 'gant' in materialName
															or 'lunette' in materialName
															or 'harnais' in materialName
															or 'masque' in materialName
															or 'protection' in materialName %}
													{% if isStMaterial %}
														<div class="col">
															<div class="form-check">
																<input class="form-check-input" type="checkbox" name="materiel[]" id="inline_materiel_{{ loop.index }}" value="{{ materiel.name }}" {{ materiel.name|lower in selectedMaterialNamesLower ? 'checked' : '' }}>
																<label class="form-check-label" for="inline_materiel_{{ loop.index }}">{{ materiel.name }}</label>
															</div>
														</div>
													{% endif %}
												{% else %}
													<p class="text-muted mb-0">Aucun matériel actif configuré.</p>
												{% endfor %}
											</div>

											<h6 class="mb-2">Autres matériels</h6>
											<div class="row g-2">
												{% for materiel in availableMateriels %}
													{% set materialName = materiel.name|lower %}
													{% set isStMaterial = 'badge' in materialName
															or 'clé' in materialName
															or 'cle' in materialName
															or 'casque' in materialName
															or 'gilet' in materialName
															or 'chaussure' in materialName
															or 'pantalon' in materialName
															or 'veste' in materialName
															or 'gant' in materialName
															or 'lunette' in materialName
															or 'harnais' in materialName
															or 'masque' in materialName
															or 'protection' in materialName %}
													{% if not isStMaterial %}
														<div class="col-md-6">
															<div class="form-check">
																<input class="form-check-input" type="checkbox" name="materiel[]" id="inline_materiel_other_{{ loop.index }}" value="{{ materiel.name }}" {{ materiel.name|lower in selectedMaterialNamesLower ? 'checked' : '' }}>
																<label class="form-check-label" for="inline_materiel_other_{{ loop.index }}">{{ materiel.name }}</label>
															</div>
														</div>
													{% endif %}
												{% endfor %}
											</div>
										{% else %}
											<h6 class="mb-2">Service technique (EPI, badge, jeu de clés)</h6>
											<ul class="resource-status-list resource-status-list--st-two-cols mb-3">
												{% for materiel in allMateriels %}
													{% set materialName = materiel.name|lower %}
													{% set isStMaterial = 'badge' in materialName
															or 'clé' in materialName
															or 'cle' in materialName
															or 'casque' in materialName
															or 'gilet' in materialName
															or 'chaussure' in materialName
															or 'pantalon' in materialName
															or 'veste' in materialName
															or 'gant' in materialName
															or 'lunette' in materialName
															or 'harnais' in materialName
															or 'masque' in materialName
															or 'protection' in materialName %}
													{% if isStMaterial %}
														{% set isAssigned = materiel.id in selectedRessourceIds %}
														<li class="resource-status-row">
															<span class="resource-status-name">{{ materiel.name }}</span>
															<span class="resource-status-pill {{ isAssigned ? 'is-assigned' : 'is-unassigned' }}">{{ isAssigned ? 'attribué' : 'non attribué' }}</span>
														</li>
													{% endif %}
												{% else %}
													<li class="resource-status-empty">Aucun matériel ST actif configuré.</li>
												{% endfor %}
											</ul>

											<h6 class="mb-2">Autres matériels</h6>
											<ul class="resource-status-list">
												{% for materiel in allMateriels %}
													{% set materialName = materiel.name|lower %}
													{% set isStMaterial = 'badge' in materialName
															or 'clé' in materialName
															or 'cle' in materialName
															or 'casque' in materialName
															or 'gilet' in materialName
															or 'chaussure' in materialName
															or 'pantalon' in materialName
															or 'veste' in materialName
															or 'gant' in materialName
															or 'lunette' in materialName
															or 'harnais' in materialName
															or 'masque' in materialName
															or 'protection' in materialName %}
													{% if not isStMaterial %}
														{% set isAssigned = materiel.id in selectedRessourceIds %}
														<li class="resource-status-row">
															<span class="resource-status-name">{{ materiel.name }}</span>
															<span class="resource-status-pill {{ isAssigned ? 'is-assigned' : 'is-unassigned' }}">{{ isAssigned ? 'attribué' : 'non attribué' }}</span>
														</li>
													{% endif %}
												{% endfor %}
											</ul>
										{% endif %}
									</div>
								</div>
							</div>
						</div>
					</div>

					{% if requestEntity.type == 'fermeture' %}
						<div class="col-12">
							<div class="card border-warning-subtle">
								<div class="card-header">Restitution du matériel (fermeture)</div>
								<div class="card-body">
									<p class="text-muted mb-3 fw-bold">
										Cliquer sur le bouton pour changer le statut
									</p>
									<h6 class="mb-2">Matériel à remettre</h6>
									{% if closurePendingMateriels is not empty %}
										<div class="d-flex flex-column gap-2 mb-3" id="closure-pending-list">
											{% for materiel in closurePendingMateriels %}
												<div class="d-flex justify-content-between align-items-center border rounded p-2" data-closure-row="{{ materiel.id }}" data-closure-name="{{ materiel.name }}">
													<span>{{ materiel.name }}</span>
													{% set canManageThisMateriel = canMarkReturned and (materiel.id in closureManageableMaterielIds) %}
													{% set ownerLabel = closureOwnerById[materiel.id]|default('RH') %}
													{% if canManageThisMateriel %}
														<form method="post" action="{{ path('app_request_mark_returned', {id: requestEntity.id, ressourceId: materiel.id}) }}" data-closure-toggle-form="true">
															<input type="hidden" name="_token" value="{{ csrf_token('mark_returned_' ~ requestEntity.id ~ '_' ~ materiel.id) }}">
															<input type="hidden" name="version" value="{{ requestEntity.version }}">
															<button type="submit" class="btn btn-sm btn-outline-warning" title="Cliquer pour passer ce matériel en remis">
																Statut: non remis
															</button>
														</form>
													{% else %}
														<span class="badge text-bg-secondary">Géré par
															{{ ownerLabel }}
															(lecture seule)</span>
													{% endif %}
												</div>
											{% endfor %}
										</div>
									{% else %}
										<div id="closure-pending-list" class="d-flex flex-column gap-2 mb-3"></div>
										<p class="text-muted mb-3" id="closure-pending-empty">Aucun matériel en attente de remise.</p>
									{% endif %}
									{% if closurePendingMateriels is not empty %}
										<p class="text-muted mb-3 d-none" id="closure-pending-empty">Aucun matériel en attente de remise.</p>
									{% endif %}

									<h6 class="mb-2">Déjà remis</h6>
									{% if closureReturnedMateriels is not empty %}
										<div class="d-flex flex-column gap-2 mb-3" id="closure-returned-list">
											{% for materiel in closureReturnedMateriels %}
												<div class="d-flex justify-content-between align-items-center border rounded p-2" data-closure-row="{{ materiel.id }}" data-closure-name="{{ materiel.name }}">
													<span>{{ materiel.name }}</span>
													{% set canManageThisMateriel = canMarkReturned and (materiel.id in closureManageableMaterielIds) %}
													{% set ownerLabel = closureOwnerById[materiel.id]|default('RH') %}
													{% if canManageThisMateriel %}
														<form method="post" action="{{ path('app_request_mark_returned', {id: requestEntity.id, ressourceId: materiel.id}) }}" data-closure-toggle-form="true">
															<input type="hidden" name="_token" value="{{ csrf_token('mark_returned_' ~ requestEntity.id ~ '_' ~ materiel.id) }}">
															<input type="hidden" name="version" value="{{ requestEntity.version }}">
															<button type="submit" class="btn btn-sm btn-outline-success" title="Cliquer pour repasser ce matériel en non remis">
																Statut: remis
															</button>
														</form>
													{% else %}
														<span class="badge text-bg-secondary">Géré par
															{{ ownerLabel }}
															(lecture seule)</span>
													{% endif %}
												</div>
											{% endfor %}
										</div>
									{% else %}
										<div id="closure-returned-list" class="d-flex flex-column gap-2 mb-3"></div>
										<p class="text-muted mb-3" id="closure-returned-empty">Aucun matériel remis pour l’instant.</p>
									{% endif %}
									{% if closureReturnedMateriels is not empty %}
										<p class="text-muted mb-3 d-none" id="closure-returned-empty">Aucun matériel remis pour l’instant.</p>
									{% endif %}

									{% if closureUntrackedMateriels is not empty %}
										<h6 class="mb-2">Matériel non concerné</h6>
										<ul class="text-muted mb-0">
											{% for materiel in closureUntrackedMateriels %}
												<li>{{ materiel.name }}</li>
											{% endfor %}
										</ul>
									{% endif %}

									<hr class="my-4">
									<h6 class="mb-2">Validation de la fermeture</h6>
									{% if canFinalizeClosure %}
										<form method="post" action="{{ path('app_request_validate', {id: requestEntity.id}) }}" class="d-flex flex-column gap-2" id="closure-finalize-form">
											<input type="hidden" name="_token" value="{{ csrf_token('workflow_' ~ requestEntity.id) }}">
											<input type="hidden" name="version" value="{{ requestEntity.version }}">
											<label class="form-label fw-semibold mb-0">Commentaire obligatoire *</label>
											<textarea name="comment" class="form-control" rows="3" placeholder="Indiquer un commentaire de validation..." required></textarea>
											<div>
												<button type="submit" class="btn btn-success">Valider la demande</button>
											</div>
										</form>
									{% else %}
										<form method="post" action="{{ path('app_request_validate', {id: requestEntity.id}) }}" class="d-flex flex-column gap-2 d-none" id="closure-finalize-form">
											<input type="hidden" name="_token" value="{{ csrf_token('workflow_' ~ requestEntity.id) }}">
											<input type="hidden" name="version" value="{{ requestEntity.version }}">
											<label class="form-label fw-semibold mb-0">Commentaire obligatoire *</label>
											<textarea name="comment" class="form-control" rows="3" placeholder="Indiquer un commentaire de validation..." required></textarea>
											<div>
												<button type="submit" class="btn btn-success">Valider la demande</button>
											</div>
										</form>
										<p class="text-muted mb-0" id="closure-finalize-hint">Le bouton de validation sera disponible une fois le matériel remis.</p>
									{% endif %}
									{% if canFinalizeClosure %}
										<p class="text-muted mb-0 d-none" id="closure-finalize-hint">Le bouton de validation sera disponible une fois le matériel remis.</p>
									{% endif %}
								</div>
							</div>
						</div>
					{% endif %}

					{# Commentaire de la demande #}
					<div class="col-12">
						<div class="card">
							<div class="card-header">Commentaire (modification)</div>
							<div class="card-body">
								{% if canEditRequestInfo %}
								<label for="inline_commentaire" class="form-label">Ajouter votre commentaire</label>
								<textarea class="form-control" id="inline_commentaire" name="commentaire" rows="4" placeholder="Votre commentaire sera ajouté avec votre nom et la date"></textarea>
									<div class="form-text mb-3">Les commentaires existants sont conservés automatiquement. Consultez l'historique des validations pour les commentaires des services.</div>
								{% elseif isInfoEditLocked %}
									<div class="alert alert-secondary mb-0" role="alert">
										Vous avez déjà modifié cette demande une fois dans ce cycle. Pour modifier à nouveau, annulez la dernière décision.
									</div>
								{% endif %}
								
					{% if canEditRequestInfo and requestEntity.status != constant('App\\Entity\\Request::STATUS_TRAITEE') and not currentUserHasValidated %}
						<div class="col-12">
							<div class="d-flex justify-content-end gap-2">
								<button type="submit" class="btn btn-warning">Enregistrer les modifications</button>
							</div>
						</div>
					{% endif %}
							</div>
						</div>
					</div>


					{% if canEditRequestInfo %}
					</form>
			{% else %}
				</div>
			{% endif %}

			{# Historique du workflow #}
			{% include 'list_request/includes/_workflow_history.html.twig' %}
		</div>

		{# Parcours de validation #}
		{% include 'list_request/includes/_parcours_validation.html.twig' with { workflowStateResolver: workflowStateResolver } %}

	</div>

	{# Actions workflow en bas de page #}
	{% include 'list_request/includes/_workflow_actions.html.twig' with { workflowStateResolver: workflowStateResolver } %}

</div>

{% include 'list_request/includes/_scripts.html.twig' %}{% endblock %}
