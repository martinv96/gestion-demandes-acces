<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
document.addEventListener('DOMContentLoaded', function () {
    var actionButtons = Array.from(document.querySelectorAll('[data-workflow-action]'));
    var panels = Array.from(document.querySelectorAll('[data-workflow-panel]'));
    var openButtons = Array.from(document.querySelectorAll('[data-workflow-open]'));
    var cancelButtons = Array.from(document.querySelectorAll('[data-workflow-cancel]'));

    if (panels.length > 0) {
        function closeAllPanels() {
            panels.forEach(function (panel) {
                panel.classList.add('d-none');
            });

            actionButtons.forEach(function (actionBlock) {
                actionBlock.classList.remove('d-none');
            });
        }

        function openPanel(target) {
            closeAllPanels();

            var panel = document.querySelector('[data-workflow-panel="' + target + '"]');
            if (panel) {
                panel.classList.remove('d-none');
            }

            actionButtons.forEach(function (actionBlock) {
                actionBlock.classList.add('d-none');
            });
        }

        openButtons.forEach(function (button) {
            button.addEventListener('click', function () {
                openPanel(button.getAttribute('data-workflow-open'));
            });
        });

        cancelButtons.forEach(function (button) {
            button.addEventListener('click', function () {
                closeAllPanels();
            });
        });
    }

    var rhTypeRadios = Array.from(document.querySelectorAll('input[name="type"]'));
    var rhLogicielsCard = document.getElementById('rh-edit-logiciels-card');
    var rhMaterielCard = document.getElementById('rh-edit-materiel-card');

    function toggleRhResourcesByType() {
        var selectedType = null;
        rhTypeRadios.forEach(function (radio) {
            if (radio.checked) {
                selectedType = radio.value;
            }
        });

        if (!rhLogicielsCard || !rhMaterielCard) {
            return;
        }

        var isFermeture = selectedType === 'fermeture';
        rhLogicielsCard.style.display = isFermeture ? 'none' : 'block';
        rhMaterielCard.style.display = isFermeture ? 'none' : 'block';
    }

    if (rhTypeRadios.length > 0) {
        rhTypeRadios.forEach(function (radio) {
            radio.addEventListener('change', toggleRhResourcesByType);
        });
        toggleRhResourcesByType();
    }

    var closureToggleForms = Array.from(document.querySelectorAll('form[data-closure-toggle-form="true"]'));
    var pendingList = document.getElementById('closure-pending-list');
    var returnedList = document.getElementById('closure-returned-list');
    var pendingEmpty = document.getElementById('closure-pending-empty');
    var returnedEmpty = document.getElementById('closure-returned-empty');
    var finalizeForm = document.getElementById('closure-finalize-form');
    var finalizeHint = document.getElementById('closure-finalize-hint');
    var closureToggleInProgress = false;

    function setClosureToggleButtonsDisabled(disabled) {
        closureToggleForms.forEach(function (toggleForm) {
            var button = toggleForm.querySelector('button[type="submit"]');
            if (button) {
                button.disabled = disabled;
            }
        });
    }

    function refreshEmptyStates() {
        if (pendingEmpty && pendingList) {
            pendingEmpty.classList.toggle('d-none', pendingList.children.length > 0);
        }

        if (returnedEmpty && returnedList) {
            returnedEmpty.classList.toggle('d-none', returnedList.children.length > 0);
        }
    }

    function setAllVersionInputs(version) {
        if (!version) {
            return;
        }

        Array.from(document.querySelectorAll('input[name="version"]')).forEach(function (input) {
            input.value = String(version);
        });
    }

    function updateFinalizeBlock(canFinalize) {
        if (finalizeForm) {
            finalizeForm.classList.toggle('d-none', !canFinalize);
        }

        if (finalizeHint) {
            finalizeHint.classList.toggle('d-none', canFinalize);
        }
    }

    function applyRowStatus(row, newStatus) {
        var button = row.querySelector('button[type="submit"]');
        if (!button) {
            return;
        }

        if (newStatus === 'remis') {
            button.classList.remove('btn-outline-warning');
            button.classList.add('btn-outline-success');
            button.textContent = 'Statut: remis';
            button.title = 'Cliquer pour repasser ce matériel en non remis';
            if (returnedList) {
                returnedList.appendChild(row);
            }
        } else {
            button.classList.remove('btn-outline-success');
            button.classList.add('btn-outline-warning');
            button.textContent = 'Statut: non remis';
            button.title = 'Cliquer pour passer ce matériel en remis';
            if (pendingList) {
                pendingList.appendChild(row);
            }
        }
    }

    closureToggleForms.forEach(function (form) {
        form.addEventListener('submit', function () {
            setClosureToggleButtonsDisabled(true);
        });
    });
});
</script>
