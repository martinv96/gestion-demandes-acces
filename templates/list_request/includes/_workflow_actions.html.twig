{% if canValidate or canRefuse or canUndo or canUnblock %}
    <div class="validationCard row mt-4">
        <div class="col-12">
            <div class="card border-0 workflow-actions-card" id="workflowActionsCard">
                <div class="card-body">
                    <div class="workflow-actions-header mb-3">
                        <p class="workflow-actions-eyebrow mb-1">Decisions</p>
                        <h3 class="workflow-actions-title mb-0 text-secondary">Statuer sur la demande :</h3>
                    </div>
                    <div class="d-flex flex-wrap gap-3 align-items-start" id="workflowActionButtons">
                        {% if canValidate %}
                            <div data-workflow-action="validate">
                                <button class="btn workflow-action-trigger workflow-action-trigger--validate" type="button" data-workflow-open="validate">
                                    <span class="workflow-action-icon">✓</span>
                                    <span>Valider la demande</span>
                                </button>
                            </div>
                        {% endif %}

                        {% if canRefuse %}
                            <div data-workflow-action="refuse">
                                <button class="btn workflow-action-trigger workflow-action-trigger--refuse" type="button" data-workflow-open="refuse">
                                    <span class="workflow-action-icon">x</span>
                                    <span>Refuser la demande</span>
                                </button>
                            </div>
                        {% endif %}

                        {% if canUndo %}
                            <div data-workflow-action="undo">
                                <button class="btn workflow-action-trigger workflow-action-trigger--undo" type="button" data-workflow-open="undo">
                                    <span class="workflow-action-icon">↺</span>
                                    <span>Annuler la derniere decision</span>
                                </button>
                            </div>
                        {% endif %}

                        {% if canUnblock %}
                            <div data-workflow-action="unblock">
                                <button class="btn workflow-action-trigger workflow-action-trigger--undo" type="button" data-workflow-open="unblock">
                                    <span class="workflow-action-icon">↻</span>
                                    <span>Debloquer la demande (RH)</span>
                                </button>
                            </div>
                        {% endif %}

                    </div>

                    {% if canValidate %}
                        <div class="mt-3 d-none" data-workflow-panel="validate">
                            <form method="post" action="{{ path('app_request_validate', {id: requestEntity.id}) }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('workflow_' ~ requestEntity.id) }}">
                                <input type="hidden" name="version" value="{{requestEntity.version}}" >
                                <div class="mb-2">
                                    <label class="form-label fw-semibold">Commentaire obligatoire *</label>
                                    <textarea name="comment" class="form-control" rows="3" placeholder="Indiquer un commentaire de validation..." required></textarea>
                                </div>
                                <div class="d-flex gap-2">
                                    <button type="submit" class="btn workflow-submit-button workflow-submit-button--validate">Confirmer la validation</button>
                                    <button type="button" class="btn workflow-secondary-button" data-workflow-cancel>Fermer</button>
                                </div>
                            </form>
                        </div>
                    {% endif %}

                    {% if canRefuse %}
                        <div class="mt-3 d-none" data-workflow-panel="refuse">
                            <form method="post" action="{{ path('app_request_refuse', {id: requestEntity.id}) }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('workflow_' ~ requestEntity.id) }}">
                                <input type="hidden" name="version" value="{{requestEntity.version}}">
                                <div class="mb-2">
                                    <label class="form-label fw-semibold">Commentaire obligatoire *</label>
                                    <textarea name="comment" class="form-control" rows="3" placeholder="Indiquer la raison du refus..." required></textarea>
                                </div>
                                <div class="d-flex gap-2">
                                    <button type="submit" class="btn workflow-submit-button workflow-submit-button--refuse justify-content-center">Confirmer le refus</button>
                                    <button type="button" class="btn workflow-secondary-button" data-workflow-cancel>Fermer</button>
                                </div>
                            </form>
                        </div>
                    {% endif %}

                    {% if canUndo %}
                        <div class="mt-3 d-none" data-workflow-panel="undo">
                            <form method="post" action="{{ path('app_request_undo_decision', {id: requestEntity.id}) }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('workflow_undo_' ~ requestEntity.id) }}">
                                <input type="hidden" name="version" value="{{ requestEntity.version }}">
                                <div class="mb-2">
                                    <label class="form-label fw-semibold">Motif d'annulation *</label>
                                    <textarea name="comment" class="form-control" rows="3" placeholder="Expliquer pourquoi la dernière décision doit être annulée..." required></textarea>
                                </div>
                                <div class="d-flex gap-2">
                                    <button type="submit" class="btn workflow-submit-button workflow-submit-button--undo">Confirmer l'annulation</button>
                                    <button type="button" class="btn workflow-secondary-button" data-workflow-cancel>Fermer</button>
                                </div>
                            </form>
                        </div>
                    {% endif %}

                    {% if canUnblock %}
                        <div class="mt-3 d-none" data-workflow-panel="unblock">
                            <form method="post" action="{{ path('app_request_unblock', {id: requestEntity.id}) }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('workflow_unblock_' ~ requestEntity.id) }}">
                                <input type="hidden" name="version" value="{{ requestEntity.version }}">
                                <div class="mb-2">
                                    <label class="form-label fw-semibold">Motif du deblocage *</label>
                                    <textarea name="comment" class="form-control" rows="3" placeholder="Expliquer pourquoi le service RH doit débloquer cette étape..." required></textarea>
                                </div>
                                <div class="d-flex gap-2">
                                    <button type="submit" class="btn workflow-submit-button workflow-submit-button--undo">Confirmer le deblocage</button>
                                    <button type="button" class="btn workflow-secondary-button" data-workflow-cancel>Fermer</button>
                                </div>
                            </form>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
{% endif %}
