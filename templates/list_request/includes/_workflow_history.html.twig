{% import 'list_request/includes/_macros.html.twig' as macros %}

<div class="col-12 mt-4">
    <div class="card">
        <div class="card-header">Historique des validations</div>
        <div class="card-body">
            {% set sortedHistory = history|sort((a, b) => a.date <=> b.date) %}
            {% set totalHistory = sortedHistory|length %}

            {% if totalHistory > 0 %}
                {% set perPage = 5 %}
                {% set totalPages = (totalHistory / perPage)|round(0, 'ceil') %}
                {% set currentPage = app.request.query.getInt('history_page', 1) %}
                
                {% if currentPage < 1 %}{% set currentPage = 1 %}{% endif %}
                {% if totalPages > 0 and currentPage > totalPages %}{% set currentPage = totalPages %}{% endif %}
                
                {% set offset = (currentPage - 1) * perPage %}
                {% set pagedHistory = sortedHistory|slice(offset, perPage) %}

                <ul class="list-group list-group-flush history-list">
                    {% for entry in pagedHistory %}
                        {% set isRefusal = entry.newStatus starts with 'refusee_' %}
                        {% set isReturnAfterRefusal = 
                            (entry.oldStatus == 'en_attente_st' and entry.newStatus == 'en_attente_rh') 
                            or (entry.oldStatus == 'en_attente_dsi' and entry.newStatus == 'en_attente_st') 
                        %}
                        {% set eventType = isRefusal ? 'refusal' : (isReturnAfterRefusal ? 'return' : 'validation') %}
                        {% set eventLabel = isRefusal ? 'Refus' : (isReturnAfterRefusal ? 'Retour' : 'Validation') %}
                        {% set eventIcon = isRefusal ? 'x' : (isReturnAfterRefusal ? '↺' : '✓') %}
                        
                        <li class="list-group-item history-item px-0">
                            <div class="history-item-top">
                                <div class="d-flex align-items-center gap-2 flex-wrap">
                                    <span class="history-event-pill history-event-{{ eventType }}">
                                        <span class="history-event-icon">{{ eventIcon }}</span>
                                        {{ eventLabel }}
                                    </span>
                                    <span class="history-actor fw-semibold">
                                        {{ entry.user ? entry.user.displayName : 'Systeme' }}
                                    </span>
                                </div>
                                <span class="history-date">
                                    {{ entry.date ? entry.date|date('d/m/Y H:i') : '-' }}
                                </span>
                            </div>

                            <div class="history-transition mt-2">
                                {{ macros.statusBadge(entry.oldStatus) }}
                                <span class="history-arrow">→</span>
                                {{ macros.statusBadge(entry.newStatus) }}
                            </div>

                            {% if entry.commentary %}
                                <p class="history-comment mt-2 mb-0">{{ entry.commentary }}</p>
                            {% endif %}
                        </li>
                    {% endfor %}
                </ul>

                {% if totalHistory > perPage %}
                    <nav class="navigation" aria-label="Pagination historique workflow">
                        <ul class="pagination pagination-sm mb-0 justify-content-end">
                            {# fleche gauche #}
                                <li class="page-item {{ currentPage <= 1 ? 'disabled' : '' }}">
                                    <a class="page-link" href="{{ path('app_request_show', {id: requestEntity.id, history_page: currentPage - 1}) }}" aria-label="Précédent"><span aria-hidden="true">&laquo;</span>
                                    </a>
                                </li>
                            
                            {# Numéro page #}
                            {% for p in 1..totalPages %}
                                <li class="page-item {{ p == currentPage ? 'active' : '' }}">
                                    <a class="page-link" href="{{ path('app_request_show', {id: requestEntity.id, history_page: p}) }}">{{ p }}</a>
                                </li>
                            {% endfor %}

                            {# flèche droite #}
                                <li class="page-item {{ currentPage >= totalPages ? 'disabled' : '' }}">
                                    <a class="page-link" href="{{ path('app_request_show', {id: requestEntity.id, history_page: currentPage + 1}) }}"aria-label="suivant"><span aria-hidden="true">&raquo;</span>
                                    </a>
                                </li>
                        </ul>
                    </nav>
                {% endif %}

            {% else %}
                <p class="text-muted mb-0">Aucune action enregistrée.</p>
            {% endif %}
        </div>
    </div>
</div>