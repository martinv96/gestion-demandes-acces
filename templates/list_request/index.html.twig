{% extends 'base.html.twig' %}
{% import 'list_request/includes/_macros.html.twig' as macros %}

{% block title %}Liste des demandes
{% endblock %}

{% block body %}

	{# Contenu principal #}
	<div class="container-fluid app-page-fluid">
		{% block page_title %}
			<div class="d-flex justify-content-between align-items-center mb-4">
				<div>
					<h1 class="h3 mb-0">Dernières demandes</h1>
					<p class="text-muted mb-0 fs-5">Retrouvez ici le suivi de vos demandes d’accès</p>
					<p class="text-muted mb-0 fs-6 fw-lighter">(Seul le dernier état de chaque demande (Arrivée, Modification, Départ) est affiché ici. Les étapes précédentes restent consultables dans l'historique.)</p>

				</div>
				<a href="{{ path('app_new_request') }}" class="btn btn-primary">Nouvelle demande</a>
			</div>
		{% endblock %}

		{% if totalCount == 0 %}
			<div class="alert alert-info" role="alert">
				Aucune demande en base pour le moment.
				<button type="button" class="close">X</button>
			</div>
		{% else %}

			{# Filtres #}
			<div class="card mb-4 p-3">
				<form method="GET">
					<div class="d-flex align-items-center gap-2 mb-1">
						<img src="{{ asset('images/filtres/Shapetest.svg') }}" class="ImgFiltre" alt="Filtres">
						<label class="form-label form-label-sm mb-1 text-muted fw-semibold d-inline-block">Filtres</label>
					</div>
					{# Ligne 1 : statut, service, type #}
					<div class="row g-3 mb-3">
						<div class="col-12 col-md-4">
							<label class="form-label form-label-sm mb-1 text-muted fw-semibold">Statut</label>
							<select name="status" class="form-select form-select-sm" onchange="this.form.submit()">
								<option value="">Tous les statuts</option>
								{% set statusOptions = {
                            'en_attente_rh': 'En attente RH',
                            'en_attente_validation': 'En attente validation',
							'a_valider_rh': 'À valider pour RH',
							'a_valider_st': 'À valider pour ST',
							'a_valider_dsi': 'À valider pour DSI',
							'a_valider_fin': 'À valider pour Finances',
                            'traitee': 'Traitée',
                            'refusee_rh': 'Refusée RH',
                            'refusee_st': 'Refusée ST',
                            'refusee_dsi': 'Refusée DSI'
                        } %}
								{% for value, label in statusOptions %}
									<option value="{{ value }}" {% if value == filters.status %} selected {% endif %}>{{ label }}</option>
								{% endfor %}
							</select>
						</div>
						<div class="col-12 col-md-4">
							<label class="form-label form-label-sm mb-1 text-muted fw-semibold">Service</label>
							<select name="serviceId" class="form-select form-select-sm" onchange="this.form.submit()">
								<option value="">Tous les services</option>
								{% for service in services %}
									<option value="{{ service.id }}" {% if service.id == filters.serviceId %} selected {% endif %}>{{ service.name }}</option>
								{% endfor %}
							</select>
						</div>
						<div class="col-12 col-md-4">
							<label class="form-label form-label-sm mb-1 text-muted fw-semibold">Type</label>
							<select name="type" class="form-select form-select-sm" onchange="this.form.submit()">
								<option value="">Tous les types</option>
								{% set typeOptions = {
                            'ouverture': 'Arrivée',
                            'modification': 'Modification',
                            'fermeture': 'Départ'
                        } %}
								{% for value, label in typeOptions %}
									<option value="{{ value }}" {% if value == filters.type %} selected {% endif %}>{{ label }}</option>
								{% endfor %}
							</select>
						</div>
					</div>
					{# Ligne 2 : agent, date arrivée (calendrier), date départ (calendrier), reset #}
					<div class="row g-3 align-items-end">
						<div class="col-12 col-md-6 col-xl-4">
							<label class="form-label form-label-sm mb-1 text-muted fw-semibold">Agent</label>
							<div class="input-group input-group-sm">
								<input type="text" name="agent" class="form-control" placeholder="Nom ou prénom…" value="{{ filters.agent }}">
								<button type="submit" class="btn btn-outline-secondary">
									<img src="{{ asset('images/filtres/chercher.png') }}" alt="Rechercher" class="logoSearch">
								</button>
							</div>
						</div>
						{# ajout d'un calendrier avec flatpickr #}
						<div class="col-12 col-md-3 col-xl-3">
							<label class="form-label form-label-sm mb-1 text-muted fw-semibold">Date d'arrivée</label>
							<input type="text" name="arrivalDate" class="form-control form-control-sm flatpickr" placeholder="Sélectionner une date" value="{{ filters.arrivalDate }}">
						</div>
						<div class="col-12 col-md-3 col-xl-3">
							<label class="form-label form-label-sm mb-1 text-muted fw-semibold">Date de départ</label>
							<input type="text" name="departureDate" class="form-control form-control-sm flatpickr" placeholder="Sélectionner une date" value="{{ filters.departureDate }}">
						</div>
						{% if filters.status or filters.serviceId or filters.type or filters.arrivalDate or filters.departureDate or filters.agent %}
							<div class="col-12 col-md-12 col-xl-2 d-grid">
								<a href="{{ path(resetRoute ?? 'app_list_request') }}" class="btn btn-sm btn-outline-secondary">Réinitialiser</a>
							</div>
						{% endif %}
					</div>
				</form>
			</div>

			{% if requests is empty %}
				<div class="alert alert-warning" role="alert">
					Aucune demande ne correspond aux critères sélectionnés.
					<button type="button" class="close">X</button>
				</div>
			{% else %}

				<div class="d-flex justify-content-end mb-3">
					<a href="{{ path('app_request_export_csv', app.request.query.all|merge({'scope': exportScope|default('current')})) }}" class="btn btnExport">
						<img src="{{ asset('images/icones/xls.png') }}" alt="CSV" class="logoXls">
						Export XLS
					</a>
				</div>

				{# Tableau des demandes #}
				<div class="card">
					<div class="table-responsive">
						<table class="table table-hover align-middle mb-0">
							<thead class="table-light">
    <tr>
        <th scope="col">Référence</th>
        <th scope="col">Agent</th>

        {% set currentSort = app.request.query.get('sort') %}
        {% set currentDir = app.request.query.get('direction', 'DESC') %}

        {# TRI SERVICE #}
        <th scope="col">
            {% set nextDir = (currentSort == 'service' and currentDir == 'ASC') ? 'DESC' : 'ASC' %}
            Service
            <a href="{{ path(app.request.attributes.get('_route'), filters|merge({'sort': 'service', 'direction': nextDir})) }}" 
               class="sort-btn-link {{ currentSort == 'service' ? 'active-sort' : '' }}" 
               title="Trier par service">
                <span class="sort-icon-neutral">⇅</span>
            </a>
        </th>

        {# TRI TYPE #}
        <th scope="col">
            {% set nextDir = (currentSort == 'type' and currentDir == 'ASC') ? 'DESC' : 'ASC' %}
            Type
            <a href="{{ path(app.request.attributes.get('_route'), filters|merge({'sort': 'type', 'direction': nextDir})) }}" 
               class="sort-btn-link {{ currentSort == 'type' ? 'active-sort' : '' }}" 
               title="Trier par type">
                <span class="sort-icon-neutral">⇅</span>
            </a>
        </th>

        {# TRI STATUT #}
        <th scope="col">
            {% set nextDir = (currentSort == 'status' and currentDir == 'ASC') ? 'DESC' : 'ASC' %}
            Statut
            <a href="{{ path(app.request.attributes.get('_route'), filters|merge({'sort': 'status', 'direction': nextDir})) }}" 
               class="sort-btn-link {{ currentSort == 'status' ? 'active-sort' : '' }}" 
               title="Trier par statut">
                <span class="sort-icon-neutral">⇅</span>
            </a>
        </th>

        {# TRI DATE ARRIVÉE #}
        <th scope="col">
            {% set nextDir = (currentSort == 'arrivalDate' and currentDir == 'ASC') ? 'DESC' : 'ASC' %}
            Date d'arrivée
            <a href="{{ path(app.request.attributes.get('_route'), filters|merge({'sort': 'arrivalDate', 'direction': nextDir})) }}" 
               class="sort-btn-link {{ currentSort == 'arrivalDate' ? 'active-sort' : '' }}" 
               title="Trier par date d'arrivée">
                <span class="sort-icon-neutral">⇅</span>
            </a>
        </th>

        {# TRI DATE DÉPART #}
        <th scope="col">
            {% set nextDir = (currentSort == 'departureDate' and currentDir == 'ASC') ? 'DESC' : 'ASC' %}
            Date de départ
            <a href="{{ path(app.request.attributes.get('_route'), filters|merge({'sort': 'departureDate', 'direction': nextDir})) }}" 
               class="sort-btn-link {{ currentSort == 'departureDate' ? 'active-sort' : '' }}" 
               title="Trier par date de départ">
                <span class="sort-icon-neutral">⇅</span>
            </a>
        </th>

        {# TRI CRÉÉE LE #}
        <th scope="col">
            {% set nextDir = (currentSort == 'creationDate' and currentDir == 'ASC') ? 'DESC' : 'ASC' %}
            Créée le
            <a href="{{ path(app.request.attributes.get('_route'), filters|merge({'sort': 'creationDate', 'direction': nextDir})) }}" 
               class="sort-btn-link {{ currentSort == 'creationDate' ? 'active-sort' : '' }}" 
               title="Trier par date de création">
                <span class="sort-icon-neutral">⇅</span>
            </a>
        </th>

        <th scope="col" class="text-center">Action</th>
    </tr>
</thead>
							<tbody>
								{% for request in requests %}
									<tr>
										<td class="fw-semibold">{{ request.reference }}</td>
										<td>
											{% if request.agent %}
												{{ request.agent.firstname|capitalize }}
												{{ request.agent.lastname|capitalize }}
											{% elseif request.author %}
												{{ request.author.displayName}}
											{% else %}
												<span class="text-muted">-</span>
											{% endif %}
										</td>
										<td>
											{% if request.agent and request.agent.service %}
												{{ request.agent.service.name }}
											{% else %}
												<span class="text-muted">-</span>
											{% endif %}
										</td>
										<td>
											{# mapping du type #}
											{% set typeMap = {
												'ouverture': 'Arrivée',
												'modification': 'Changement de poste / Droits',
												'fermeture': 'Départ'
											} %}
											{{ typeMap[request.type] ?? request.type|capitalize }}
											{# fin mapping #}
										</td>
										<td>
											{% set statusMap = {
                                        'en_attente_rh':  ['info',    'En attente RH'],
                                        'en_attente_validation':  ['warning', 'En attente validation'],
                                        'traitee':        ['success', 'Traitée'],
                                        'refusee_rh':     ['danger',  'Refusée RH'],
                                        'refusee_st':     ['danger',  'Refusée ST'],
                                        'refusee_dsi':    ['danger',  'Refusée DSI'],
                                    } %}
											{% if request.status in statusMap|keys %}
												{% set cfg = statusMap[request.status] %}
											{% elseif request.status starts with 'en_attente_' %}
												{% set roleLabel = request.status|replace({'en_attente_': ''})|upper %}
												{% set cfg = ['secondary', 'En attente ' ~ roleLabel] %}
											{% elseif request.status starts with 'refusee_' %}
												{% set roleLabel = request.status|replace({'refusee_': ''})|upper %}
												{% set cfg = ['danger', 'Refusée ' ~ roleLabel] %}
											{% else %}
												{% set cfg = ['secondary', request.status|replace({'_': ' '})] %}
											{% endif %}
											{{ macros.statusBadge(request.status) }}
										</td>
										<td>{{ request.arrivalDate ? request.arrivalDate|date('d/m/Y') : '-' }}</td>
										<td>{{ request.departureDate ? request.departureDate|date('d/m/Y') : '-'}}</td>
										<td>{{ request.creationDate ? request.creationDate|date('d/m/Y à H:i') : '-' }}</td>
										<td class="text-center">
											<a href="{{ path('app_request_show', {id: request.id}) }}">
												<img
												src="{{ asset('images/icones/chercher1.png') }}" alt="Voir" class="logoAction">
											<!-- Voir -->
											</a>
										</td>
									</tr>
								{% endfor %}
							</tbody>
						</table>
					</div>
				</div>
			{% endif %}

			{# pagination par bloc de 5 #}
			{% if pagesCount > 1 %}
				<nav class="mt-4" aria-label="Navigation des pages">
					{% set paginationRoute = pageRoute|default('app_list_request') %}

					{# Calcul dynamique du bloc de 5 #}
					{% set startPage = (((currentPage - 1) // 5) * 5) + 1 %}
					{% set endPage = min(startPage + 4, pagesCount) %}

					<ul
						class="pagination pagination-sm mb-0 gap-1 align-items-center">

						{# bouton précédent apparait seulement si le bloc commence après la page 1 #}
						{% if startPage > 1 %}
							{% set prevBlockPage = startPage - 5 %}
							<li class="page-item">
								<a class="page-link rounded d-flex align-items-center justify-content-center px-2" href="{{ path(paginationRoute, filters|merge({'page': prevBlockPage})) }}" style="height: 32px;" title="Bloc précédent">
									&laquo; Précédent
								</a>
							</li>
						{% endif %}

						{# numéro du bloc actuel (ex: 1 à 5, ou 6 à 10) #}
						{% for i in startPage..endPage %}
							<li class="page-item {{ i == currentPage ? 'active' : '' }}">
								<a class="page-link rounded d-flex align-items-center justify-content-center" href="{{ path(paginationRoute, filters|merge({'page': i})) }}" style="width: 32px; height: 32px; padding: 0;">
									{{ i }}
								</a>
							</li>
						{% endfor %}

						{# bouton suivant apparait seulement s'il reste encore des pages après ce bloc #}
						{% if endPage < pagesCount %}
							{% set nextBlockPage = startPage + 5 %}
							<li class="page-item">
								<a class="page-link rounded d-flex align-items-center justify-content-center px-2" href="{{ path(paginationRoute, filters|merge({'page': nextBlockPage})) }}" style="height: 32px;" title="Bloc suivant">
									Suivant &raquo;
								</a>
							</li>
						{% endif %}

					</ul>
				</nav>
			{% endif %}
		{% endif %}

		{% block content %}{% endblock %}
	</div>

	<script>
		document.addEventListener('DOMContentLoaded', function () {
flatpickr('.flatpickr', {
dateFormat: 'Y-m-d',
locale: 'fr',
allowInput: true,
onChange: function (selectedDates, dateStr, instance) {
instance.input.form.submit();
}
});
});
	</script>
{% endblock %}
