{% extends 'base.html.twig' %}

{% block title %}Liste des demandes{% endblock %}

{% block body %}
<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-1">Demandes d'acces</h1>
            <p class="text-muted mb-0">Suivi des demandes et des ressources associees</p>
        </div>
        <a href="{{ path('app_new_request') }}" class="btn btn-primary">Nouvelle demande</a>
    </div>

    {% if requests is empty %}
        <div class="alert alert-info" role="alert">
            Aucune demande en base pour le moment.
        </div>
    {% else %}
        <div class="card">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                               <th scope="col">Référence</th>
                            <th scope="col">Agent</th>
                            <th scope="col">Service</th>
                            <th scope="col">Type</th>
                            <th scope="col">Statut</th>
                            <th scope="col">Date arrivée</th>
                            <th scope="col">Créée le</th>
                            <th scope="col"></th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for request in requests %}
                            <tr>
                                    <td class="fw-semibold">{{ 'REQ-%03d'|format(loop.index) }}</td>
                                <td>
                                    {% if request.agent %}
                                        {{ request.agent.firstname }} {{ request.agent.lastname }}
                                    {% else %}
                                        <span class="text-muted">-</span>
                                    {% endif %}
                                </td>
                                <td>
                                    {% if request.agent and request.agent.service %}
                                        {{ request.agent.service.name }}
                                    {% else %}
                                        <span class="text-muted">-</span>
                                    {% endif %}
                                </td>
                                <td class="text-capitalize">{{ request.type }}</td>
                                <td>
                                    {% set statusMap = {
                                        'en_attente_rh':  ['info',    'En attente RH'],
                                        'en_attente_st':  ['warning', 'En attente DGA-ST'],
                                        'en_attente_dsi': ['primary', 'En attente DSI'],
                                        'traitee':        ['success', 'Traitée'],
                                        'refusee_rh':     ['danger',  'Refusée RH'],
                                        'refusee_st':     ['danger',  'Refusée DGA-ST'],
                                        'refusee_dsi':    ['danger',  'Refusée DSI'],
                                    } %}
                                    {% set cfg = statusMap[request.status] ?? ['secondary', request.status|replace({'_': ' '})] %}
                                    <span class="badge text-bg-{{ cfg[0] }}">{{ cfg[1] }}</span>
                                </td>
                                <td>{{ request.arrivalDate ? request.arrivalDate|date('d/m/Y') : '-' }}</td>
                                <td>{{ request.creationDate ? request.creationDate|date('d/m/Y H:i') : '-' }}</td>
                                <td class="text-end">
                                    <a href="{{ path('app_request_show', {id: request.id}) }}" class="btn btn-sm btn-outline-secondary">Voir</a>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    {% endif %}
</div>
{% endblock %}
