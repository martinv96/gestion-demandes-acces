{% extends 'base.html.twig' %}
{% import 'list_request/includes/_macros.html.twig' as macros %}

{% block title %}Suivi de mes demandes
{% endblock %}

{% block body %}
	{% set services = services|default([]) %}
	{% set requests = requests|default([]) %}
	{% set filters = filters|default({'serviceId': null, 'type': null, 'agent': ''}) %}
	{% set currentPage = currentPage|default(1) %}
	{% set pagesCount = pagesCount|default(1) %}
	{% set totalRequests = totalRequests|default(0) %}
	<div
		class="my-requests-page">
		{# En-tête de la page #}
		<div class="d-flex justify-content-between align-items-center mb-4">
			<div>
				<h1 class="h3 mb-1 fw-bold my-requests-title">Suivi de mes demandes</h1>
				<p class="fs-6 mb-0 my-requests-subtitle">Retrouvez l'état d'avancement des demandes que vous avez initiées</p>
			</div>
			<a href="{{ path('app_new_request') }}" class="btn btn-primary shadow-sm px-3 my-requests-new-btn">
				<i class="fas fa-plus fa-sm me-2"></i>
				Nouvelle demande
			</a>
		</div>

		{# filtres #}
		<div class="card mb-4 p-3">
			<form method="GET">
				<div class="d-flex align-items-center gap-2 mb-1">
					<img src="{{ asset('images/filtres/Shapetest.svg') }}" class="ImgFiltre" alt="Filtres">
					<label class="form-label form-label-sm mb-1 text-muted fw-semibold d-inline-block">Filtres</label>
				</div>

				<div
					class="row g-3">
					{# première ligne : Service #}
					<div class="col-12 col-md-4">
						<label class="form-label form-label-sm mb-1 text-muted fw-semibold">Service</label>
						<select name="serviceId" class="form-select form-select-sm" onchange="this.form.submit()">
							<option value="">Tous les services</option>
							{% for service in services %}
								<option value="{{ service.id }}" {% if service.id == filters.serviceId %} selected {% endif %}>{{ service.name }}</option>
							{% endfor %}
						</select>
					</div>

					{# Deuxième colonne : Type #}
					<div class="col-12 col-md-4">
						<label class="form-label form-label-sm mb-1 text-muted fw-semibold">Type</label>
						<select name="type" class="form-select form-select-sm" onchange="this.form.submit()">
							<option value="">Tous les types</option>
							{% set typeOptions = {
								'ouverture' : 'Arrivée',
								'fermeture' : 'Départ'
                    		} %}
							{% for value, label in typeOptions %}
								<option value="{{ value }}" {% if value == filters.type %} selected {% endif %}>{{ label }}</option>
							{% endfor %}
						</select>
					</div>

					{# Troisième colonne : Agent #}
					<div class="col-12 col-md-4">
						<label class="form-label form-label-sm mb-1 text-muted fw-semibold">Agent</label>
						<div class="input-group input-group-sm">
							<input type="text" name="agent" class="form-control" placeholder="Nom ou prénom..." value="{{ filters.agent|default('') }}">
							<button type="submit" class="btn btn-outline-secondary">
								<img src="{{ asset('images/filtres/chercher.png') }}" alt="Rechercher" class="logoSearch" style="max-height: 15px;">
							</button>
						</div>
					</div>
				</div>
			</form>
		</div>

		{# Tableau des Demandes #}
		<div class="card border-0 shadow-sm my-requests-card">
			<div class="card-body p-0">
				<div class="table-responsive">
					<table class="table table-hover align-middle mb-0 my-requests-table">
						<thead class="small text-uppercase border-bottom my-requests-thead">
							<tr>
								<th class="ps-4 py-3" style="font-size: 0.75rem;">Référence</th>
								<th class="py-3" style="font-size: 0.75rem; padding-left: 1.4rem">Type</th>
								<th class="py-3" style="font-size: 0.75rem;">Agent concerné</th>
								<th class="py-3" style="font-size: 0.75rem;">Date de création</th>
								<th class="py-3" style="font-size: 0.75rem;">Statut actuel</th>
								<th class="py-3 text-end" style="font-size: 0.75rem; padding-right: 3rem;">Action</th>
							</tr>
						</thead>
						<tbody>
							{% for req in requests %}
								<tr
									class="border-bottom">
									{# 1. Référence #}
									<td class="ps-4 fw-semibold my-requests-ref" style="font-size: 0.9rem;">
										{{ req.reference|default('REQ-' ~ req.creationDate|date('Y') ~ '-' ~ req.id) }}
									</td>

									{# 2. Type #}
									<td>
										{% set type_mapping = {
											'ouverture' : 'Arrivée',
											'Ouverture' : 'Arrivée',
											'fermeture'  :'Départ',
											'Fermeture' : 'Départ'
										} %}
										<span class="badge border px-2.5 py-1.5 fw-medium text-capitalize my-requests-type-badge" style="font-size: 0.8rem; border-radius: 12px;">
											{{ type_mapping[req.type] | default(req.type) }}
										</span>
									</td>

									{# 3. Agent #}
									<td>
										{% if req.agent and req.agent.service %}
											<span class="fw-bold text-uppercase my-requests-service" style="font-size: 0.85rem; letter-spacing: 0.5px; color: #17623f;">
												{{ req.agent.lastname }}
												{{ req.agent.firstname}}
											</span>
										{% else %}
											<span class="small my-requests-muted">Aucun agent lié</span>
										{% endif %}
									</td>

									{# 4. Date de création #}
									<td class="my-requests-date" style="font-size: 0.85rem;">
										{{ req.creationDate|date('d/m/Y à H:i') }}
									</td>

									{# 5. Statut actuel #}
									<td>
										{{ macros.statusBadge(req.status) }}
									</td>

									{# 6. Action #}
									<td class="pe-4 text-end">
										<div class="d-inline-flex gap-2">
											<a href="{{ path('app_request_show', {'id': req.id}) }}" class="btn btn-sm btn-outline-secondary fw-medium px-2.5 py-1.5 shadow-sm my-requests-detail-btn" style="border-radius: 6px; font-size: 0.8rem; border: none;">
												<img src="{{ asset('images/icones/chercher1.png') }}" alt="voir" class="logoAction">
											</a>

											{% set isAdminOrRh = is_granted('ROLE_ADMIN') or is_granted('ROLE_RH') %}
											{% set isAuthor = (req.author is defined and req.author == app.user) %}

											{# On vérifie si la demande est encore à l'état initial (non validée par RH) #}
											{% set isPendingRh = req.status in ['a_valider_rh', 'en_attente_rh', 'STATUS_EN_ATTENTE_RH', constant('App\\Entity\\Request::STATUS_EN_ATTENTE_RH')] %}

											{% set canDelete = isAdminOrRh or (isAuthor and isPendingRh) %}

											{% if canDelete %}
												<button type="button" class="btn btn-sm btn-outline-danger fw-medium px-2.5 py-1.5 shadow-sm" data-bs-toggle="modal" data-bs-target="#deleteRequestModal{{ req.id }}" style="border-radius: 6px; font-size: 0.8rem; border: none;">
													<img src="{{ asset('images/icones/btnDelete.png') }}" alt="supprimer" class="logoAction">
												</button>
											{% endif %}
										</div>
									</td>
								</tr>
							{% else %}
								<tr>
									<td colspan="6" class="text-center py-5 my-requests-muted">
										<i class="fas fa-folder-open d-block mb-3 fa-2x my-requests-empty-icon"></i>
										Vous n'avez pas encore créé de demande d'accès.
									</td>
								</tr>
							{% endfor %}
						</tbody>
					</table>
				</div>

				{# Modale de confirmation de suppression pour chaque demande #}
				{% for req in requests %}
					{% set isAdminOrRh = is_granted('ROLE_ADMIN') or is_granted('ROLE_RH') %}
					{% set isAuthor = (req.author is defined and req.author == app.user) %}
					{% set isPendingRh = req.status in ['a_valider_rh', 'en_attente_rh', 'STATUS_EN_ATTENTE_RH', constant('App\\Entity\\Request::STATUS_EN_ATTENTE_RH')] %}

					{% set canDelete = isAdminOrRh or (isAuthor and isPendingRh) %}

					{% if canDelete %}
						<div class="modal fade" id="deleteRequestModal{{ req.id }}" tabindex="-1" aria-labelledby="deleteRequestModalLabel{{ req.id }}" aria-hidden="true">
							<div class="modal-dialog modal-dialog-centered">
								<div class="modal-content admin-modal">
									<div class="modal-header border-0 pb-1">
										<div>
											<h5 class="modal-title mb-0" id="deleteRequestModalLabel{{ req.id }}">Supprimer la demande</h5>
											<p class="text-danger small mb-0">Cette action est irréversible</p>
										</div>
										<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
									</div>
									<form method="post" action="{{ path('app_request_delete', {'id': req.id}) }}">
										<input type="hidden" name="_token" value="{{ csrf_token('request_delete_' ~ req.id) }}">
										<div class="modal-body">
											<p class="mb-2">
												Êtes-vous sûr de vouloir supprimer définitivement la demande
												<strong>#{{ req.id }}</strong>
												{% if req.agent is defined and req.agent %}
													concernant
													<strong>{{ req.agent.firstname }}
														{{ req.agent.lastname }}</strong>
												{% endif %}
												?
											</p>
											<p class="text-muted small mb-0">
												La suppression entraînera le nettoyage complet de l'historique et des ressources liées à cette demande.
											</p>
										</div>
										<div class="modal-footer border-0 pt-0">
											<button type="submit" class="btn btn-danger">Supprimer la demande</button>
											<button type="button" class="btn btn-link text-secondary" data-bs-dismiss="modal">Annuler</button>
										</div>
									</form>
								</div>
							</div>
						</div>
					{% endif %}
				{% endfor %}

				{# Footer avec Pagination (Uniquement si pagesCount > 1) #}
				<div class="d-flex justify-content-between align-items-center px-4 py-3 border-top my-requests-footer">
					<div class="small my-requests-muted">
						{{ totalRequests }}
						{{ totalRequests > 1 ? 'demandes trouvées' : 'demande trouvée' }}
					</div>

					{# pagination par bloc de 5 #}
					{% if pagesCount > 1 %}
						<nav class="mt-4" aria-label="Navigation des pages">
							{% set paginationRoute = pageRoute|default('app_my_requests') %}

							{# Calcul dynamique du bloc de 5 #}
							{% set startPage = (((currentPage - 1) // 5) * 5) + 1 %}
							{% set endPage = min(startPage + 4, pagesCount) %}

							<ul
								class="pagination pagination-sm mb-0 gap-1 align-items-center">

								{# bouton précédent apparaît seulement si le bloc commence après la page 1 #}
								{% if startPage > 1 %}
									{% set prevBlockPage = startPage - 5 %}
									<li class="page-item">
										<a class="page-link rounded d-flex align-items-center justify-content-center px-2" href="{{ path(paginationRoute, filters|merge({'page': prevBlockPage})) }}" style="height: 32px;" title="Bloc précédent">
											&laquo; Précédent
										</a>
									</li>
								{% endif %}

								{# bloc actuel (ex: 1 à 5, ou 6 à 10) #}
								{% for i in startPage..endPage %}
									<li class="page-item {{ i == currentPage ? 'active' : '' }}">
										<a class="page-link rounded d-flex align-items-center justify-content-center" href="{{ path(paginationRoute, filters|merge({'page': i})) }}" style="width: 32px; height: 32px; padding: 0;">
											{{ i }}
										</a>
									</li>
								{% endfor %}

								{# bouton suivant apparaît seulement s'il reste encore des pages après ce bloc #}
								{% if endPage < pagesCount %}
									{% set nextBlockPage = startPage + 5 %}
									<li class="page-item">
										<a class="page-link rounded d-flex align-items-center justify-content-center px-2" href="{{ path(paginationRoute, filters|merge({'page': nextBlockPage})) }}" style="height: 32px;" title="Bloc suivant">
											Suivant &raquo;
										</a>
									</li>
								{% endif %}

							</ul>
						</nav>
					{% endif %}
				</div>
			</div>
		</div>
	</div>
{% endblock %}
